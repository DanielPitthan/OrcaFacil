<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrcaFacil.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- 0.105.0 depende de SixLabors.Fonts >= 1.0.0 sem teto. A 2.x muda a licença
         e a SixLabors.Fonts 3.x quebra com TypeLoadException em GlyphMetrics em qualquer sistema
         (ClosedXML #2844), não só no Android. -->
    <PackageReference Include="SixLabors.Fonts" Version="[1.0.0,2.0.0)" />
  </ItemGroup>

</Project>
