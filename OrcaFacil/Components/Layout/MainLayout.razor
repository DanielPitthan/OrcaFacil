@inherits LayoutComponentBase
@implements IDisposable
@inject CascoNavegacao Casco
@inject ITemaAppService TemaApp
@inject IJSRuntime Js

@* false: o padrão do MudBlazor observa o WebView e troca a paleta mesmo com Claro ou Escuro forçado. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @if (Casco.Barra is { } barra)
        {
            @barra
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Abrir menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">Pro Orçamento</MudText>
            <MudSpacer />
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <PerfilHeader />
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private string _classeCss = MapeamentoTema.ClasseClaro;
    private string? _classeAplicada;
    private MudTheme _theme = OrcaFacil.Theme.OrcaFacilThemes.Light;

    protected override void OnInitialized()
    {
        Casco.Alterado += OnCascoAlterado;
        Casco.AlternarMenu += OnAlternarMenu;

        // UserAppTheme dispara RequestedThemeChanged na hora, no mesmo call stack.
        // Aplica e lê o tema efetivo antes de assinar: senão o StateHasChanged do
        // handler corre dentro do OnInitialized e o layout renderiza duas vezes.
        TemaApp.AplicarPreferenciaSalva();
        AtualizarTema(Application.Current?.RequestedTheme ?? AppTheme.Light);

        if (Application.Current is not null)
            Application.Current.RequestedThemeChanged += OnRequestedThemeChanged;
    }

    private void OnRequestedThemeChanged(object? sender, AppThemeChangedEventArgs e)
    {
        var solicitado = e.RequestedTheme;
        _ = InvokeAsync(() =>
        {
            if (!AtualizarTema(solicitado))
                return;

            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _classeAplicada == _classeCss)
            return;

        var classe = _classeCss;
        try
        {
            await Js.InvokeVoidAsync("OrcaFacilTema.aplicar", classe);
            _classeAplicada = classe;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <returns>true quando o claro/escuro efetivo mudou.</returns>
    private bool AtualizarTema(AppTheme appTheme)
    {
        var escuro = MapeamentoTema.IsDarkMode(ParaTemaUsuario(appTheme));
        var classe = MapeamentoTema.ClasseCss(escuro);
        var theme = escuro ? OrcaFacil.Theme.OrcaFacilThemes.Dark : OrcaFacil.Theme.OrcaFacilThemes.Light;
        if (_isDarkMode == escuro && _classeCss == classe && ReferenceEquals(_theme, theme))
            return false;

        _isDarkMode = escuro;
        _classeCss = classe;
        _theme = theme;
        return true;
    }

    private static TemaUsuarioApp ParaTemaUsuario(AppTheme tema) => tema switch
    {
        AppTheme.Dark => TemaUsuarioApp.Dark,
        AppTheme.Light => TemaUsuarioApp.Light,
        _ => TemaUsuarioApp.Unspecified
    };

    private void OnCascoAlterado() => _ = InvokeAsync(StateHasChanged);

    private void OnAlternarMenu()
    {
        _drawerOpen = !_drawerOpen;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Casco.Alterado -= OnCascoAlterado;
        Casco.AlternarMenu -= OnAlternarMenu;
        if (Application.Current is not null)
            Application.Current.RequestedThemeChanged -= OnRequestedThemeChanged;
    }
}
