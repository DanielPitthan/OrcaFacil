@typeparam TItem

<div class="of-lista">
    <div class="of-lista-cabeca">
        <span>@Contagem</span>
        <span class="of-moeda">@SomaFormatada</span>
    </div>

    @if (Itens.Count == 0)
    {
        <p class="of-lista-vazia">@TextoVazio</p>
    }
    else
    {
        <ul class="of-lista-itens">
            @foreach (var item in Itens)
            {
                var emErro = EmErro?.Invoke(item) == true;
                var marcador = Marcador?.Invoke(item);
                <li @key="Chave(item)" class="@ClasseItem(item, emErro)">
                    <span class="of-lista-icone" style="@Fundo(item)" aria-hidden="true">@Icone(item)</span>
                    @if (ExigeMarcacao?.Invoke(item) == true)
                    {
                        <button type="button" class="of-lista-marca" role="checkbox"
                                aria-checked="@(Marcado?.Invoke(item) == true ? "true" : "false")"
                                aria-label="@(AriaMarcacao?.Invoke(item) ?? "Marcar item")"
                                @onclick="() => OnAlternarMarcacao.InvokeAsync(item)">
                            @(Marcado?.Invoke(item) == true ? "✓" : "")
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(marcador))
                    {
                        <span class="of-lista-chip @SufixoChip(item)">@marcador</span>
                    }
                    <span class="of-lista-texto">
                        <span class="of-lista-titulo@(emErro ? " of-lista-titulo-erro" : null)">@Titulo(item)</span>
                        <span class="of-lista-sub">@Subtitulo(item)</span>
                    </span>
                    <span class="of-lista-valor of-moeda @(EhCredito?.Invoke(item) == true ? "of-lista-valor-credito" : null)">@Valor(item)</span>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@AriaMenu(item)" Size="Size.Medium"
                             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="@(() => OnEditar.InvokeAsync(item))">Editar</MudMenuItem>
                        <MudMenuItem OnClick="@(() => OnRemover.InvokeAsync(item))">Remover</MudMenuItem>
                    </MudMenu>
                </li>
            }
        </ul>
    }

    @if (OnEstorno.HasDelegate)
    {
        <div class="of-lista-acoes">
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Class="of-lista-acao" OnClick="OnAdicionar">
                @TextoAdicionar
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Success" StartIcon="@Icons.Material.Filled.Undo"
                       Class="of-lista-acao" Disabled="@EstornoDesabilitado" OnClick="OnEstorno"
                       aria-label="@TextoEstorno">
                @TextoEstorno
            </MudButton>
            @if (OnImportar.HasDelegate)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
                           Class="of-lista-acao of-lista-acao-larga" ButtonType="ButtonType.Button"
                           OnClick="OnImportar" aria-label="@TextoImportar">
                    @TextoImportar
                </MudButton>
            }
        </div>
    }
    else if (MostrarAdicionar)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Class="of-lista-adicionar" OnClick="OnAdicionar">
            @TextoAdicionar
        </MudButton>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Itens { get; set; } = [];
    [Parameter] public string Contagem { get; set; } = "";
    [Parameter] public string SomaFormatada { get; set; } = "";
    [Parameter] public string TextoVazio { get; set; } = "Nenhum item ainda. Inclua um por vez.";
    [Parameter] public string TextoAdicionar { get; set; } = "Adicionar item";
    [Parameter, EditorRequired] public Func<TItem, string> Titulo { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, string> Subtitulo { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, string> Valor { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, string> Icone { get; set; } = null!;
    [Parameter] public Func<TItem, string?>? Cor { get; set; }
    [Parameter] public Func<TItem, object>? ChaveItem { get; set; }
    [Parameter] public Func<TItem, bool>? EhCredito { get; set; }
    [Parameter] public EventCallback<TItem> OnEditar { get; set; }
    [Parameter] public EventCallback<TItem> OnRemover { get; set; }
    [Parameter] public EventCallback OnAdicionar { get; set; }
    [Parameter] public EventCallback OnEstorno { get; set; }
    [Parameter] public bool EstornoDesabilitado { get; set; }
    [Parameter] public string TextoEstorno { get; set; } = "Estorno";
    [Parameter] public EventCallback OnImportar { get; set; }
    [Parameter] public string TextoImportar { get; set; } = "Importar CSV";

    /// <summary>Opcional. Sem o delegate, a lista continua igual às telas atuais.</summary>
    [Parameter] public Func<TItem, bool>? EmErro { get; set; }

    [Parameter] public Func<TItem, bool>? ExigeMarcacao { get; set; }

    [Parameter] public Func<TItem, bool>? Marcado { get; set; }

    [Parameter] public EventCallback<TItem> OnAlternarMarcacao { get; set; }

    [Parameter] public Func<TItem, string>? AriaMarcacao { get; set; }

    [Parameter] public Func<TItem, string?>? Marcador { get; set; }

    [Parameter] public Func<TItem, bool>? Destacado { get; set; }

    [Parameter] public Func<TItem, bool>? ConfirmadoVisual { get; set; }

    [Parameter] public Func<TItem, string?>? ComplementoAriaMenu { get; set; }

    /// <summary>Opcional. Falso esconde só o botão de incluir, quando não há estorno.</summary>
    [Parameter] public bool MostrarAdicionar { get; set; } = true;

    private object Chave(TItem item) => ChaveItem?.Invoke(item) ?? (object)item!;

    private string? Fundo(TItem item)
    {
        var cor = Cor?.Invoke(item);
        return string.IsNullOrWhiteSpace(cor) ? null : $"background:{cor}";
    }

    private string AriaMenu(TItem item)
    {
        var extra = ComplementoAriaMenu?.Invoke(item);
        return string.IsNullOrWhiteSpace(extra)
            ? $"Ações de {Titulo(item)}"
            : $"Ações de {Titulo(item)}, {extra}";
    }

    private string ClasseItem(TItem item, bool emErro)
    {
        var classe = "of-lista-item";
        if (emErro)
            classe += " of-lista-item-erro";
        if (Destacado?.Invoke(item) == true)
            classe += " of-lista-item-pendente";
        return classe;
    }

    private string? SufixoChip(TItem item)
    {
        if (Destacado?.Invoke(item) == true)
            return "of-lista-chip-pendente";
        if (ConfirmadoVisual?.Invoke(item) == true)
            return "of-lista-chip-confirmado";
        return null;
    }
}
