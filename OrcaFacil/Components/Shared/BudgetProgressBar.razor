<div>
    <div class="d-flex justify-space-between mb-1">
        <MudText Typo="Typo.body2">@ValorGasto.ToString("C") de @ValorLimite.ToString("C")</MudText>
        <MudText Typo="Typo.body2" Style="@($"color:{BudgetColorRule.ToHex(Percentual)}")">@Percentual.ToString("0.#")%</MudText>
    </div>
    <MudProgressLinear Color="BudgetColorRule.ToMudColor(Percentual)" Value="@((double)Math.Min(Percentual, 100))" Rounded="true" Size="Size.Medium" />
</div>

@code {
    [Parameter] public decimal ValorGasto { get; set; }
    [Parameter] public decimal ValorLimite { get; set; }

    private decimal Percentual => ValorLimite <= 0 ? 0 : Math.Round(ValorGasto / ValorLimite * 100m, 1);
}
