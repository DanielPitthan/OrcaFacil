@inject IDialogService DialogService

<div class="d-flex flex-wrap ga-2 align-center">
    @foreach (var cor in CoresCategoria.Opcoes)
    {
        <button type="button"
                class="of-color-swatch @(string.Equals(cor, Value, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                style="background-color:@cor;"
                aria-label="@cor"
                aria-pressed="@(string.Equals(cor, Value, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                @onclick="() => Selecionar(cor)">
        </button>
    }
    <div class="of-campo-paleta">
        <button type="button" class="of-abrir-paleta" @onclick="AbrirPaletaAsync" aria-label="@($"Outras cores, {Value}")">
            <span class="of-abrir-paleta-rotulo">Outras cores</span>
            <span class="of-abrir-paleta-valor">@Value</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = "#A2B94F";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private async Task Selecionar(string cor)
    {
        Value = cor;
        await ValueChanged.InvokeAsync(cor);
    }

    private bool _abrindo;

    private async Task AbrirPaletaAsync()
    {
        if (_abrindo)
            return;

        _abrindo = true;
        try
        {
            var parametros = new DialogParameters<PaletaCategoriaDialog>
            {
                { x => x.CorOriginal, Value }
            };
            var opcoes = new DialogOptions
            {
                CloseOnEscapeKey = true,
                BackdropClick = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            };
            var dialog = await DialogService.ShowAsync<PaletaCategoriaDialog>("Outras cores", parametros, opcoes);
            var resultado = await dialog.Result;
            var confirmou = resultado is { Canceled: false };
            var cor = DecisaoCorPaleta.Resolver(Value, resultado?.Data as string, confirmou);
            if (string.Equals(cor, Value, StringComparison.OrdinalIgnoreCase))
                return;

            Value = cor;
            await ValueChanged.InvokeAsync(cor);
        }
        finally
        {
            _abrindo = false;
        }
    }
}
