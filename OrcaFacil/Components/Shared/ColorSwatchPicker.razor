<div class="d-flex flex-wrap ga-2 align-center">
    @foreach (var cor in CoresCategoria.Opcoes)
    {
        <div class="of-color-swatch @(string.Equals(cor, Value, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
             style="background-color:@cor;"
             @onclick="() => Selecionar(cor)">
        </div>
    }
    <MudColorPicker Value="@(new MudColor(Value))" ValueChanged="OnColorPickerChanged" Label="Outras cores" Style="width:180px" ShowAlpha="false" />
</div>

@code {
    [Parameter] public string Value { get; set; } = "#A2B94F";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private async Task Selecionar(string cor)
    {
        Value = cor;
        await ValueChanged.InvokeAsync(cor);
    }

    private async Task OnColorPickerChanged(MudColor cor)
    {
        Value = cor.ToString(MudColorOutputFormats.Hex);
        await ValueChanged.InvokeAsync(Value);
    }
}
