@using Microsoft.EntityFrameworkCore
@using OrcaFacil.Core.Armazenamento.Espelho.Pasta
@using OrcaFacil.Core.Dirpf
@using OrcaFacil.Core.Exportacao
@using OrcaFacil.Core.Llm
@implements IDisposable
@inject IDbContextFactory<AppDbContext> ContextoFactory
@inject IConfiguracaoService Configuracao
@inject ICompartilhadorArquivoLocal Compartilhador

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Planilha</MudText>
    <p id="aviso-planilha-clara" class="mb-3" role="note">O arquivo exportado não é criptografado e contém os dados financeiros em claro.</p>

    @if (Orquestrador.Exportando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" aria-label="Exportando a planilha" />
    }

    @if (!string.IsNullOrEmpty(Orquestrador.Aviso))
    {
        <MudAlert Severity="@(Orquestrador.FolhaAberta ? Severity.Info : Severity.Error)" Dense="true" Class="mb-3">@Orquestrador.Aviso</MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@Orquestrador.Exportando"
               aria-describedby="aviso-planilha-clara"
               OnClick="ExportarAsync">
        @(Orquestrador.Exportando ? "Exportando…" : "Exportar para Excel")
    </MudButton>

    <MudNumericField T="int" @bind-Value="_anoBase" Label="Ano-base" Min="1900" Max="2200"
                     Variant="Variant.Text" Margin="Margin.Dense" Class="mt-4" Style="max-width: 8rem;" />
    @if (OrquestradorDirpf.Exportando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" aria-label="Gerando a DIRPF" />
    }
    @if (!string.IsNullOrEmpty(OrquestradorDirpf.Aviso))
    {
        <MudAlert Severity="@(OrquestradorDirpf.FolhaAberta ? Severity.Info : Severity.Error)" Dense="true" Class="mb-3">@OrquestradorDirpf.Aviso</MudAlert>
    }
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-3"
               Disabled="@OrquestradorDirpf.Exportando"
               aria-describedby="aviso-planilha-clara"
               OnClick="ExportarDirpfAsync">
        @(OrquestradorDirpf.Exportando ? "Gerando…" : "Gerar DIRPF")
    </MudButton>
</MudPaper>

@code {
    private static readonly OrquestradorExportacaoPlanilha Orquestrador = new(TimeProvider.System);
    private static readonly OrquestradorExportacaoPlanilha OrquestradorDirpf = new(TimeProvider.System);
    private AcompanhamentoExportacaoPlanilha? _acompanhamento;
    private AcompanhamentoExportacaoPlanilha? _acompanhamentoDirpf;
    private int _anoBase;

    protected override void OnInitialized()
    {
        _anoBase = AnoBaseDirpf.Anterior(TimeProvider.System.GetLocalNow().DateTime);
        _acompanhamento = new AcompanhamentoExportacaoPlanilha(Orquestrador, () => InvokeAsync(StateHasChanged));
        _acompanhamentoDirpf = new AcompanhamentoExportacaoPlanilha(OrquestradorDirpf, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose()
    {
        _acompanhamento?.Dispose();
        _acompanhamentoDirpf?.Dispose();
    }

    private async Task ExportarAsync()
    {
        try
        {
            var tarefa = Orquestrador.ExportarAsync(
                MontarConfiguracao,
                () => FileSystem.CacheDirectory,
                Gravar,
                AbrirFolha);
            if (tarefa.IsCompletedSuccessfully && !tarefa.Result.Executou)
                return;

            await tarefa;
        }
        catch (Exception ex)
        {
            await AvisarFalhaAsync(ex);
        }
    }

    private async Task AvisarFalhaAsync(Exception ex)
    {
        _acompanhamento?.RegistrarFalha(ex);
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception falha)
        {
            _acompanhamento?.RegistrarFalha(falha);
        }
    }

    private void Gravar(string caminho, ConfiguracaoExportavel configuracao)
    {
        using var contexto = ContextoFactory.CreateDbContext();
        using (var destino = new FileStream(caminho, FileMode.CreateNew, FileAccess.Write, FileShare.None))
        {
            ExportadorPlanilha.Exportar(contexto, configuracao, destino);
            destino.Flush();
        }
    }

    private async Task<DesfechoCompartilhamentoPlanilha> AbrirFolha(string caminho)
    {
        var resultado = await Compartilhador.CompartilharAsync(caminho, "Exportar para Excel");
        if (resultado.Sucesso)
            return DesfechoCompartilhamentoPlanilha.FolhaAberta;

        if (resultado.Codigo == CodigoFalhaPastaEspelho.Cancelado)
            return DesfechoCompartilhamentoPlanilha.Cancelado;

        return DesfechoCompartilhamentoPlanilha.Falhou;
    }

    private ConfiguracaoExportavel MontarConfiguracao()
    {
        return new ConfiguracaoExportavel
        {
            Tema = Configuracao.Tema,
            NotificacoesAtivas = Configuracao.NotificacoesAtivas,
            SomAtivo = Configuracao.SomAtivo,
            GraficoLancamentosExpandido = Configuracao.GraficoLancamentosExpandido,
            PrazosAviso = Configuracao.PrazosAviso,
            Provedor = Configuracao.ProvedorInteligencia is { } provedor
                ? ChipsInteligencia.Texto(provedor)
                : null,
            Url = Configuracao.UrlInteligencia,
            Modelo = Configuracao.ModeloInteligencia
        };
    }

    private async Task ExportarDirpfAsync()
    {
        var ano = _anoBase;
        try
        {
            var tarefa = OrquestradorDirpf.ExportarAsync(
                MontarConfiguracao,
                () => FileSystem.CacheDirectory,
                (caminho, _) => GravarDirpf(caminho, ano),
                AbrirDirpf);
            if (tarefa.IsCompletedSuccessfully && !tarefa.Result.Executou)
                return;

            await tarefa;
        }
        catch (Exception ex)
        {
            await AvisarFalhaDirpfAsync(ex);
        }
    }

    private async Task AvisarFalhaDirpfAsync(Exception ex)
    {
        _acompanhamentoDirpf?.RegistrarFalha(ex);
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception falha)
        {
            _acompanhamentoDirpf?.RegistrarFalha(falha);
        }
    }

    private void GravarDirpf(string caminho, int anoBase)
    {
        using var contexto = ContextoFactory.CreateDbContext();
        using (var destino = new FileStream(caminho, FileMode.CreateNew, FileAccess.Write, FileShare.None))
        {
            ExportadorDirpf.Exportar(contexto, anoBase, destino);
            destino.Flush();
        }
    }

    private async Task<DesfechoCompartilhamentoPlanilha> AbrirDirpf(string caminho)
    {
        var resultado = await Compartilhador.CompartilharAsync(caminho, "Gerar DIRPF");
        if (resultado.Sucesso)
            return DesfechoCompartilhamentoPlanilha.FolhaAberta;

        if (resultado.Codigo == CodigoFalhaPastaEspelho.Cancelado)
            return DesfechoCompartilhamentoPlanilha.Cancelado;

        return DesfechoCompartilhamentoPlanilha.Falhou;
    }
}
