<MudDialog>
    <DialogContent>
        <EditForm Model="Modelo" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />

            <MudPaper Outlined="true" Class="d-flex justify-space-between pa-3 mb-3">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total do cartão</MudText>
                    <MudText Typo="Typo.subtitle1">@TotalFatura.ToString("C")</MudText>
                </div>
                <div style="text-align:right;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(FaltaDistribuir < 0 ? "Excede o total em" : "Falta distribuir")</MudText>
                    <MudText Typo="Typo.subtitle1" Color="@(FaltaDistribuir < 0 ? Color.Error : Color.Primary)">
                        <b>@Math.Abs(FaltaDistribuir).ToString("C")</b>
                    </MudText>
                </div>
            </MudPaper>

            <MudTextField T="string" Label="Descrição" Placeholder="Ex.: Netflix, Jogo de jantar"
                          @bind-Value="Modelo.Descricao" For="@(() => Modelo.Descricao)" Class="mb-3" />

            <CampoNumerico TNumber="decimal" Label="Valor" @bind-Value="Modelo.Valor" For="@(() => Modelo.Valor)"
                            Adornment="Adornment.Start" AdornmentText="R$" Class="mb-3" />

            <MudSelect T="int" @bind-Value="Modelo.CategoriaId" For="@(() => Modelo.CategoriaId)" Label="Categoria" Class="mb-3">
                @foreach (var categoria in Categorias)
                {
                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.caption" Color="Color.Secondary">Natureza</MudText>
            <MudChipSet T="NaturezaItemLancamento" SelectedValue="Modelo.Natureza" SelectedValueChanged="AlterarNatureza"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Class="mb-3">
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Avulsa" Text="Avulsa" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Parcelada" Text="Parcelada" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Assinatura" Text="Assinatura" Color="Color.Primary" Variant="Variant.Outlined" />
            </MudChipSet>

            @if (Modelo.Natureza == NaturezaItemLancamento.Parcelada)
            {
                <div class="d-flex align-center ga-2 mb-1">
                    <MudNumericField T="int?" @bind-Value="Modelo.ParcelaAtual" Label="Parcela" Min="1" Style="flex:1;" />
                    <MudText Typo="Typo.h6">/</MudText>
                    <MudNumericField T="int?" @bind-Value="Modelo.TotalParcelas" Label="de" Min="1" Style="flex:1;" />
                </div>
                @if (_erroParcela is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_erroParcela</MudText>
                }
            }
            else if (Modelo.Natureza == NaturezaItemLancamento.Assinatura)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Repete na fatura seguinte ao trazer o mês anterior.</MudText>
            }

            <div class="d-flex ga-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Salvar item</MudButton>
                <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ItemLancamentoFormModel Modelo { get; set; } = new();
    [Parameter] public IReadOnlyList<Categoria> Categorias { get; set; } = Array.Empty<Categoria>();

    /// <summary>Quanto da fatura ainda não foi classificado, desconsiderando o próprio item.</summary>
    [Parameter] public decimal Disponivel { get; set; }

    [Parameter] public decimal TotalFatura { get; set; }

    private decimal FaltaDistribuir => Disponivel - Modelo.Valor;

    private string? _erroParcela;

    private void AlterarNatureza(NaturezaItemLancamento natureza)
    {
        Modelo.Natureza = natureza;
        _erroParcela = null;
        if (natureza == NaturezaItemLancamento.Parcelada)
        {
            Modelo.ParcelaAtual ??= 1;
            return;
        }

        Modelo.ParcelaAtual = null;
        Modelo.TotalParcelas = null;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Salvar()
    {
        if (Modelo.Natureza == NaturezaItemLancamento.Parcelada
            && (Modelo.ParcelaAtual is not > 0 || Modelo.TotalParcelas is not > 0 || Modelo.ParcelaAtual > Modelo.TotalParcelas))
        {
            _erroParcela = "Informe a parcela atual e o total, por exemplo 2 de 12.";
            return;
        }

        Modelo.Descricao = Modelo.Descricao.Trim();
        MudDialog.Close(DialogResult.Ok(Modelo));
    }
}
