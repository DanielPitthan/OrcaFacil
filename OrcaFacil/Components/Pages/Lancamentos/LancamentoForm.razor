@page "/lancamentos/novo"
@page "/lancamentos/editar/{Id:int}"
@inject ITransacaoService TransacaoService
@inject ICategoriaService CategoriaService
@inject IFechamentoService FechamentoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">@(Id.HasValue ? "Editar Lançamento" : "Novo Lançamento")</MudText>

@if (PeriodoBloqueado)
{
    <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Lock" Dense="true" Class="mb-3">
        @(_periodoOriginalFechado
            ? $"Este lançamento pertence a um mês fechado ({_dataOriginal:MM/yyyy}). Reabra o período na tela de Lançamentos para alterá-lo."
            : $"O mês {_data:MM/yyyy} está fechado. Escolha outra data ou reabra o período.")
    </MudAlert>
}

<EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
    <DataAnnotationsValidator />

    <MudPaper Class="pa-4" Elevation="2">
        <MudTextField T="string" Label="Descrição" @bind-Value="_modelo.Descricao" For="@(() => _modelo.Descricao)" Class="mb-3" />

        <CampoNumerico TNumber="decimal" Label="Valor" @bind-Value="_modelo.Valor" For="@(() => _modelo.Valor)"
                        Adornment="Adornment.Start" AdornmentText="R$" Class="mb-3" />

        <MudDatePicker Label="Data" @bind-Date="_data" @bind-Date:after="VerificarPeriodoAsync" Class="mb-3" />

        <MudSelect T="TipoTransacao" Value="_modelo.Tipo" ValueChanged="OnTipoChanged" Label="Tipo" Class="mb-3">
            <MudSelectItem Value="TipoTransacao.Despesa">Despesa</MudSelectItem>
            <MudSelectItem Value="TipoTransacao.Receita">Receita</MudSelectItem>
        </MudSelect>

        @if (_modelo.Tipo == TipoTransacao.Despesa)
        {
            <MudCheckBox T="bool" @bind-Value="_modelo.Pago" Label="Pago" Class="mb-3" />
        }

        <MudSelect T="int" @bind-Value="_modelo.CategoriaId" Label="Categoria" For="@(() => _modelo.CategoriaId)" Class="mb-3">
            @foreach (var categoria in CategoriasFiltradas)
            {
                <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="TipoRecorrencia" @bind-Value="_modelo.Recorrencia" Label="Recorrência" Class="mb-3">
            <MudSelectItem Value="TipoRecorrencia.Unica">Única</MudSelectItem>
            <MudSelectItem Value="TipoRecorrencia.Semanal">Semanal</MudSelectItem>
            <MudSelectItem Value="TipoRecorrencia.Mensal">Mensal</MudSelectItem>
            <MudSelectItem Value="TipoRecorrencia.Anual">Anual</MudSelectItem>
        </MudSelect>

        <MudTextField T="string" Label="Observação (opcional)" @bind-Value="_modelo.Observacao" Lines="2" Class="mb-3" />

        @if (MostrarItens)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle2">Itens da fatura</MudText>
                    @if (_modelo.Itens.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_modelo.Itens.Count @(_modelo.Itens.Count == 1 ? "item" : "itens")</MudText>
                    }
                </div>

                @if (_modelo.Itens.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block my-2">
                        Opcional. Detalhe compras, parcelas e assinaturas; cada item entra na própria categoria e o restante fica em @_categoriaSelecionada?.Nome.
                    </MudText>
                }
                else
                {
                    <MudProgressLinear Value="@PercentualClassificado" Color="@(SomaEstoura ? Color.Error : Color.Primary)"
                                       Rounded="true" Size="Size.Small" Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption">Classificado @SomaItens.ToString("C")</MudText>
                        <MudText Typo="Typo.caption" Color="@(SomaEstoura ? Color.Error : Color.Secondary)">
                            @(SomaEstoura ? $"Excede {(-Restante):C}" : $"Restante {Restante:C}")
                        </MudText>
                    </div>

                    <MudList T="ItemLancamentoFormModel" Dense="true" Class="mt-1">
                        @foreach (var item in _modelo.Itens)
                        {
                            var categoria = _categorias.FirstOrDefault(c => c.Id == item.CategoriaId);
                            <MudListItem T="ItemLancamentoFormModel" OnClick="@(() => EditarItemAsync(item))" Class="px-0">
                                <div class="d-flex justify-space-between align-center ga-2" style="width:100%">
                                    <div style="min-width:0;">
                                        <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@categoria?.Icone @item.Descricao</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@categoria?.Nome · @RotuloNatureza(item)</MudText>
                                    </div>
                                    <div class="d-flex align-center" @onclick:stopPropagation="true">
                                        <MudText Typo="Typo.body2" Style="white-space:nowrap;">@item.Valor.ToString("C")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remover item"
                                                       OnClick="@(() => _modelo.Itens.Remove(item))" />
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }

                @if (SomaEstoura)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">A soma dos itens não pode passar do total da fatura.</MudAlert>
                }

                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(!CategoriasDosItens.Any())" OnClick="AdicionarItemAsync" Class="mt-1">
                    Adicionar item
                </MudButton>
            </MudPaper>
        }

        <div class="d-flex ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@(PeriodoBloqueado || SomaEstoura)">Salvar</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => NavigationManager.NavigateTo("/lancamentos"))">Cancelar</MudButton>
        </div>
    </MudPaper>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }

    private readonly TransacaoFormModel _modelo = new();
    private List<Categoria> _categorias = new();
    private DateTime? _data = DateTime.Today;
    private DateTime? _dataOriginal;
    private bool _periodoOriginalFechado;
    private bool _periodoDataFechado;

    private bool PeriodoBloqueado => _periodoOriginalFechado || _periodoDataFechado;

    private IEnumerable<Categoria> CategoriasFiltradas =>
        _categorias.Where(c => c.TipoPadrao == _modelo.Tipo);

    private Categoria? _categoriaSelecionada => _categorias.FirstOrDefault(c => c.Id == _modelo.CategoriaId);

    private bool MostrarItens => _modelo.Tipo == TipoTransacao.Despesa && _categoriaSelecionada?.PermiteItensFatura == true;

    private IEnumerable<Categoria> CategoriasDosItens =>
        CategoriasFiltradas.Where(c => c.Id != _modelo.CategoriaId);

    private decimal SomaItens => _modelo.Itens.Sum(i => i.Valor);

    private decimal Restante => _modelo.Valor - SomaItens;

    private bool SomaEstoura => MostrarItens && _modelo.Itens.Count > 0 && SomaItens > _modelo.Valor;

    protected override async Task OnInitializedAsync()
    {
        _categorias = await CategoriaService.ListarAsync();

        if (Id.HasValue)
        {
            var transacao = await TransacaoService.ObterAsync(Id.Value);
            if (transacao is not null)
            {
                _modelo.Id = transacao.Id;
                _modelo.Descricao = transacao.Descricao;
                _modelo.Valor = transacao.Valor;
                _modelo.Data = transacao.Data;
                _modelo.Tipo = transacao.Tipo;
                _modelo.Recorrencia = transacao.Recorrencia;
                _modelo.Pago = transacao.Pago;
                _modelo.Observacao = transacao.Observacao;
                _modelo.CategoriaId = transacao.CategoriaId;
                _modelo.Itens = transacao.Itens
                    .OrderBy(i => i.Ordem)
                    .Select(i => new ItemLancamentoFormModel
                    {
                        Id = i.Id,
                        Descricao = i.Descricao,
                        Valor = i.Valor,
                        Natureza = i.Natureza,
                        ParcelaAtual = i.ParcelaAtual,
                        TotalParcelas = i.TotalParcelas,
                        CategoriaId = i.CategoriaId
                    })
                    .ToList();
                _data = transacao.Data;
                _dataOriginal = transacao.Data;
                _periodoOriginalFechado = await FechamentoService.EstaFechadoAsync(transacao.Data.Month, transacao.Data.Year);
            }
        }
        else
        {
            GarantirCategoriaValida();
        }

        await VerificarPeriodoAsync();
    }

    private async Task VerificarPeriodoAsync()
    {
        var data = _data ?? DateTime.Today;
        _periodoDataFechado = await FechamentoService.EstaFechadoAsync(data.Month, data.Year);
    }

    private Task OnTipoChanged(TipoTransacao tipo)
    {
        _modelo.Tipo = tipo;
        if (tipo != TipoTransacao.Despesa)
            _modelo.Pago = true;
        GarantirCategoriaValida();
        return Task.CompletedTask;
    }

    private void GarantirCategoriaValida()
    {
        var filtradas = CategoriasFiltradas.ToList();
        if (filtradas.Count == 0)
            return;

        if (filtradas.All(c => c.Id != _modelo.CategoriaId))
            _modelo.CategoriaId = filtradas[0].Id;
    }

    private double PercentualClassificado =>
        _modelo.Valor <= 0 ? 100 : (double)Math.Min(100m, SomaItens / _modelo.Valor * 100m);

    private static string RotuloNatureza(ItemLancamentoFormModel item) => item.Natureza switch
    {
        NaturezaItemLancamento.Parcelada => $"Parcela {item.ParcelaAtual}/{item.TotalParcelas}",
        NaturezaItemLancamento.Assinatura => "Assinatura",
        _ => "Avulsa"
    };

    private async Task AdicionarItemAsync()
    {
        var novo = new ItemLancamentoFormModel
        {
            CategoriaId = CategoriasDosItens.FirstOrDefault()?.Id ?? 0,
            Natureza = NaturezaItemLancamento.Avulsa
        };

        var salvo = await AbrirItemAsync("Novo item", novo, Restante);
        if (salvo is not null)
            _modelo.Itens.Add(salvo);
    }

    private async Task EditarItemAsync(ItemLancamentoFormModel item)
    {
        var copia = new ItemLancamentoFormModel
        {
            Id = item.Id,
            Descricao = item.Descricao,
            Valor = item.Valor,
            Natureza = item.Natureza,
            ParcelaAtual = item.ParcelaAtual,
            TotalParcelas = item.TotalParcelas,
            CategoriaId = item.CategoriaId
        };

        var salvo = await AbrirItemAsync("Editar item", copia, Restante + item.Valor);
        if (salvo is null)
            return;

        var indice = _modelo.Itens.IndexOf(item);
        if (indice >= 0)
            _modelo.Itens[indice] = salvo;
    }

    private async Task<ItemLancamentoFormModel?> AbrirItemAsync(string titulo, ItemLancamentoFormModel modelo, decimal disponivel)
    {
        var parametros = new DialogParameters<ItemFaturaDialog>
        {
            { x => x.Modelo, modelo },
            { x => x.Categorias, CategoriasDosItens.ToList() },
            { x => x.Disponivel, disponivel },
            { x => x.TotalFatura, _modelo.Valor }
        };
        var opcoes = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ItemFaturaDialog>(titulo, parametros, opcoes);
        var resultado = await dialog.Result;

        return resultado is { Canceled: false, Data: ItemLancamentoFormModel salvo } ? salvo : null;
    }

    private async Task SalvarAsync()
    {
        _modelo.Data = _data ?? DateTime.Today;
        if (!MostrarItens)
            _modelo.Itens.Clear();

        try
        {
            if (Id.HasValue)
                await TransacaoService.AtualizarAsync(Id.Value, _modelo);
            else
                await TransacaoService.CriarAsync(_modelo);

            Snackbar.Add("Lançamento salvo com sucesso", Severity.Success);
            NavigationManager.NavigateTo("/lancamentos");
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
