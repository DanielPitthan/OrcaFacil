@page "/lancamentos/novo"
@using Microsoft.EntityFrameworkCore
@using OrcaFacil.Core.Exportacao
@using Serilog
@page "/lancamentos/editar/{Id:int}"
@implements IDisposable
@inject ITransacaoService TransacaoService
@inject ICategoriaService CategoriaService
@inject ICartaoService CartaoService
@inject IFechamentoService FechamentoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CascoNavegacao Casco
@inject RascunhoLancamento Rascunho

@if (_carregando)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (UsarLayoutFatura)
{
    <EditForm Model="_modelo" OnSubmit="SalvarSePermitidoAsync">
        <DataAnnotationsValidator />
        <FaturaCartaoPainel @ref="_painel" Modelo="_modelo" Data="_data" DataChanged="AlterarDataFaturaAsync"
                            PeriodoBloqueado="PeriodoBloqueado" MensagemPeriodo="@MensagemPeriodo"
                            Categorias="_categorias" Cartoes="CartoesCreditoDisponiveis"
                            OnCancelar="Voltar" OnAlterouCartao="AtualizarCasco" />
    </EditForm>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">@(Id.HasValue ? "Editar Lançamento" : "Novo Lançamento")</MudText>
        @if (Id.HasValue)
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AriaLabel="Ações do lançamento"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Disabled="@(!PodeExcluir)" OnClick="ExcluirAsync">Excluir</MudMenuItem>
            </MudMenu>
        }
    </div>

@if (PeriodoBloqueado)
{
    <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Lock" Dense="true" Class="mb-3">
        @(_periodoOriginalFechado
            ? $"Este lançamento pertence a um mês fechado ({_dataOriginal:MM/yyyy}). Reabra o período na tela de Lançamentos para alterá-lo."
            : $"O mês {_data:MM/yyyy} está fechado. Escolha outra data ou reabra o período.")
    </MudAlert>
}

<EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
    <DataAnnotationsValidator />

    @if (MostrarItens)
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudSelect T="int" Value="_modelo.CategoriaId" ValueChanged="OnCategoriaChanged" Label="Categoria" For="@(() => _modelo.CategoriaId)" Class="mb-3">
                @foreach (var categoria in CategoriasFiltradas)
                {
                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
                }
            </MudSelect>

            <div class="of-lancamento-topo mb-3">
                <div class="of-lancamento-descricao">
                    <MudTextField T="string" Label="Descrição" @bind-Value="_modelo.Descricao" For="@(() => _modelo.Descricao)" />
                </div>
                <div class="of-lancamento-data">
                    <MudDatePicker Label="Data" @bind-Date="_data" @bind-Date:after="VerificarPeriodoAsync" />
                </div>
            </div>

            @if (EhCartaoCredito)
            {
                @if (CartoesCreditoDisponiveis.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Cadastre seus cartões em Cartões para associar esta fatura a um cartão.
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="int?" @bind-Value="_modelo.CartaoId" Label="Cartão de crédito" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var cartao in CartoesCreditoDisponiveis)
                        {
                            <MudSelectItem T="int?" Value="@((int?)cartao.Id)">@cartao.Rotulo</MudSelectItem>
                        }
                    </MudSelect>
                }
            }

            @* Passar item, como no caixa. Cada inclusão é uma linha nova, mesmo repetindo a categoria. *@
            <MudText Typo="Typo.subtitle2">Passar item</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">A categoria pode se repetir. Use o descritivo para dizer onde foi cada compra.</MudText>
            <MudSelect T="int" @bind-Value="_itemCategoriaId" Label="Despesa" Class="mb-2" AnchorOrigin="Origin.BottomCenter">
                @foreach (var categoria in CategoriasDosItens)
                {
                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_itemDescritivo" Label="Descritivo (opcional)"
                          Placeholder="Ex.: McDonald's, Big Steak, Netflix"
                          MaxLength="@ItensFaturaInclusao.DescritivoMaximo" Counter="@ItensFaturaInclusao.DescritivoMaximo"
                          Immediate="true" Class="mb-2" />
            <div class="of-linha-valor mb-2">
                <div class="of-linha-valor-campo">
                    <CampoNumerico @ref="_valorCampo" TNumber="decimal" @bind-Value="_itemValor" Label="Valor"
                                    Adornment="Adornment.Start" AdornmentText="R$" />
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="Incluir item" Color="Color.Success"
                               Variant="Variant.Filled" Size="Size.Medium" OnClick="IncluirItemAsync" />
            </div>

            <MudText Typo="Typo.caption" Color="Color.Secondary">Natureza</MudText>
            <MudChipSet T="NaturezaItemLancamento" SelectedValue="_itemNatureza" SelectedValueChanged="AlterarNatureza"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Class="mb-2">
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Avulsa" Text="Avulsa" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Parcelada" Text="Parcelada" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="NaturezaItemLancamento" Value="NaturezaItemLancamento.Assinatura" Text="Assinatura" Color="Color.Primary" Variant="Variant.Outlined" />
            </MudChipSet>
            @if (_itemNatureza == NaturezaItemLancamento.Parcelada)
            {
                <div class="d-flex align-center ga-2 mb-2">
                    <MudNumericField T="int?" @bind-Value="_itemParcelaAtual" Label="Parcela" Min="1" Style="flex:1;"
                                     InputMode="InputMode.numeric" UserAttributes="@AtributosInteiro" />
                    <MudText Typo="Typo.h6">/</MudText>
                    <MudNumericField T="int?" @bind-Value="_itemTotalParcelas" Label="de" Min="1" Style="flex:1;"
                                     InputMode="InputMode.numeric" UserAttributes="@AtributosInteiro" />
                </div>
            }
            else if (_itemNatureza == NaturezaItemLancamento.Assinatura)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Repete na fatura seguinte ao trazer o mês anterior.</MudText>
            }

            @if (_erroItem is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">@_erroItem</MudText>
            }

            @* Lista de itens passados *@
            @if (_modelo.Itens.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Nenhum item ainda. Inclua um por vez, como no caixa.</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">@_modelo.Itens.Count @(_modelo.Itens.Count == 1 ? "item" : "itens")</MudText>
                @foreach (var item in _modelo.Itens)
                {
                    var categoria = _categorias.FirstOrDefault(c => c.Id == item.CategoriaId);
                    <div @key="item" class="of-item-fatura">
                        <div class="of-item-fatura-texto">
                            @if (_linhaEditando == item)
                            {
                                <MudTextField T="string" @bind-Value="item.Descritivo" Label="Descritivo (opcional)"
                                              Placeholder="Ex.: McDonald's, Netflix"
                                              MaxLength="@ItensFaturaInclusao.DescritivoMaximo" Counter="@ItensFaturaInclusao.DescritivoMaximo"
                                              Immediate="true" Class="mb-1" />
                                <CampoNumerico TNumber="decimal" @bind-Value="item.Valor" Label="Valor"
                                                Adornment="Adornment.Start" AdornmentText="R$" />
                            }
                            else
                            {
                                <div style="cursor:pointer;" @onclick="@(() => EditarLinha(item))">
                                    <MudText Typo="Typo.body1" Class="of-item-descritivo">@categoria?.Icone @ItensFaturaInclusao.Titulo(item.Descritivo, categoria?.Nome ?? item.Descricao)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@LegendaItem(item, categoria)</MudText>
                                </div>
                            }
                        </div>
                        @if (_linhaEditando == item)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"
                                           aria-label="Confirmar item" OnClick="@(() => ConfirmarEdicao(item))" />
                        }
                        else
                        {
                            <div style="cursor:pointer;" @onclick="@(() => EditarLinha(item))">
                                <MudText Typo="Typo.body2">@item.Valor.ToString("C")</MudText>
                            </div>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" aria-label="Remover item"
                                       OnClick="@(() => RemoverLinha(item))" />
                    </div>
                }
                <MudDivider Class="my-2" />
            }

            @* Pagamento, só no fim *@
            <MudText Typo="Typo.subtitle2" Class="mb-2">Pagamento</MudText>
            <CampoNumerico TNumber="decimal" Label="Total da fatura" @bind-Value="_modelo.Valor" For="@(() => _modelo.Valor)"
                            Adornment="Adornment.Start" AdornmentText="R$" Class="mb-2" />

            @if (_modelo.Itens.Count > 0)
            {
                <MudProgressLinear Value="@PercentualClassificado" Color="@(SomaEstoura ? Color.Error : Color.Primary)"
                                   Rounded="true" Size="Size.Small" Class="mb-1" />
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.caption">Itens somam @SomaItens.ToString("C")</MudText>
                    <MudText Typo="Typo.caption" Color="@(SomaEstoura ? Color.Error : Color.Secondary)">
                        @(SomaEstoura ? $"Excede o total em {(-Restante):C}" : $"Restante {_categoriaSelecionada?.Nome}: {Restante:C}")
                    </MudText>
                </div>
            }
            @if (SomaEstoura)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">A soma dos itens não pode passar do total da fatura.</MudAlert>
            }

            <MudCheckBox T="bool" @bind-Value="_modelo.Pago" Label="Pago" Class="mb-2" />

            <MudSelect T="TipoRecorrencia" @bind-Value="_modelo.Recorrencia" Label="Recorrência" Class="mb-2">
                <MudSelectItem Value="TipoRecorrencia.Unica">Única</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Semanal">Semanal</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Mensal">Mensal</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Anual">Anual</MudSelectItem>
            </MudSelect>

            <div class="of-form-acoes">
                <MudButton Variant="Variant.Text" OnClick="Voltar">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@(PeriodoBloqueado || SomaEstoura)">Salvar</MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudSelect T="int" Value="_modelo.CategoriaId" ValueChanged="OnCategoriaChanged" Label="Categoria" For="@(() => _modelo.CategoriaId)" Class="mb-3">
                @foreach (var categoria in CategoriasFiltradas)
                {
                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string" Label="Descrição" @bind-Value="_modelo.Descricao" For="@(() => _modelo.Descricao)" Class="mb-3" />

            <MudDatePicker Label="Data" @bind-Date="_data" @bind-Date:after="VerificarPeriodoAsync" Class="mb-3" />

            <CampoNumerico TNumber="decimal" Label="Valor" @bind-Value="_modelo.Valor" For="@(() => _modelo.Valor)"
                            Adornment="Adornment.Start" AdornmentText="R$" Class="mb-3" />

            <MudCheckBox T="bool" @bind-Value="_modelo.Pago" Label="Pago" Class="mb-3" />

            <MudSelect T="TipoRecorrencia" @bind-Value="_modelo.Recorrencia" Label="Recorrência" Class="mb-3">
                <MudSelectItem Value="TipoRecorrencia.Unica">Única</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Semanal">Semanal</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Mensal">Mensal</MudSelectItem>
                <MudSelectItem Value="TipoRecorrencia.Anual">Anual</MudSelectItem>
            </MudSelect>

            <div class="of-form-acoes">
                <MudButton Variant="Variant.Text" OnClick="Voltar">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@PeriodoBloqueado">Salvar</MudButton>
            </div>
        </MudPaper>
    }
</EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "mes")]
    public string? MesConsulta { get; set; }

    private readonly TransacaoFormModel _modelo = new();
    private List<Categoria> _categorias = new();
    private List<Cartao> _cartoesCredito = new();
    private DateTime? _data = DateTime.Today;
    private DateTime? _dataOriginal;
    private bool _periodoOriginalFechado;
    private bool _periodoDataFechado;

    private static readonly Dictionary<string, object?> AtributosInteiro = new()
    {
        ["inputmode"] = "numeric"
    };

    private CampoNumerico<decimal> _valorCampo = null!;
    private FaturaCartaoPainel? _painel;
    private RenderFragment? _barraCache;
    private bool _cascoLigado;
    private bool _carregando = true;
    private bool _sessaoPronta;
    private int? _idAplicado;
    private int _itemCategoriaId;
    private string? _itemDescritivo;
    private decimal _itemValor;
    private NaturezaItemLancamento _itemNatureza = NaturezaItemLancamento.Avulsa;
    private int? _itemParcelaAtual;
    private int? _itemTotalParcelas;
    private ItemLancamentoFormModel? _linhaEditando;
    private string? _erroItem;

    private bool PeriodoBloqueado => _periodoOriginalFechado || _periodoDataFechado;

    private IEnumerable<Categoria> CategoriasFiltradas =>
        _categorias.Where(c => c.Ativo);

    private Categoria? _categoriaSelecionada => _categorias.FirstOrDefault(c => c.Id == _modelo.CategoriaId);

    private bool EhCartaoCredito => _modelo.Tipo == TipoTransacao.Despesa
        && string.Equals(_categoriaSelecionada?.Nome, "Cartão de Crédito", StringComparison.OrdinalIgnoreCase);

    private List<Cartao> CartoesCreditoDisponiveis =>
        _cartoesCredito.Where(c => c.Ativo || c.Id == _modelo.CartaoId).ToList();

    private bool MostrarItens => _modelo.Tipo == TipoTransacao.Despesa && _categoriaSelecionada?.PermiteItensFatura == true;

    private bool UsarLayoutFatura => EhCartaoCredito && MostrarItens;

    private bool PodeExcluir => Id.HasValue && !PeriodoBloqueado;

    private bool PodeDuplicar => Id.HasValue;

    private string SubtituloCartao =>
        CartoesCreditoDisponiveis.FirstOrDefault(c => c.Id == _modelo.CartaoId)?.Rotulo ?? "Sem cartão vinculado";

    private string? MensagemPeriodo => !PeriodoBloqueado
        ? null
        : _periodoOriginalFechado
            ? $"Este lançamento pertence a um mês fechado ({_dataOriginal:MM/yyyy}). Reabra o período na tela de Lançamentos para alterá-lo."
            : $"O mês {_data:MM/yyyy} está fechado. Escolha outra data ou reabra o período.";

    private RenderFragment BarraFatura => @<BarraFaturaCartao Subtitulo="@SubtituloCartao" PodeExcluir="@PodeExcluir"
                                                              PodeDuplicar="@PodeDuplicar" OnVoltar="Voltar"
                                                              OnExcluir="ExcluirAsync" OnDuplicar="DuplicarAsync" />;

    private IEnumerable<Categoria> CategoriasDosItens =>
        _categorias.Where(c => c.Ativo && c.TipoPadrao == TipoTransacao.Despesa && c.Id != _modelo.CategoriaId);

    private decimal SomaItens => FaturaCartaoEditor.Soma(_modelo.Itens);

    private decimal Restante => _modelo.Valor - SomaItens;

    private bool SomaEstoura => MostrarItens && _modelo.Itens.Count > 0 && SomaItens > _modelo.Valor;

    protected override async Task OnParametersSetAsync()
    {
        if (_sessaoPronta && _idAplicado == Id)
            return;

        _sessaoPronta = true;
        _idAplicado = Id;
        await AbrirSessaoAsync();
    }

    private async Task AbrirSessaoAsync()
    {
        _carregando = true;
        _categorias = await CategoriaService.ListarAsync();
        _cartoesCredito = await CartaoService.ListarAsync(somenteAtivos: false, TipoCartao.Credito);
        _periodoOriginalFechado = false;
        _dataOriginal = null;
        _linhaEditando = null;
        _erroItem = null;
        _itemValor = 0;
        _itemDescritivo = null;
        _itemNatureza = NaturezaItemLancamento.Avulsa;
        _itemParcelaAtual = null;
        _itemTotalParcelas = null;

        if (Id.HasValue)
        {
            var transacao = await TransacaoService.ObterAsync(Id.Value);
            if (transacao is not null)
            {
                _modelo.Id = transacao.Id;
                _modelo.Descricao = transacao.Descricao;
                _modelo.Valor = transacao.Valor;
                _modelo.Data = transacao.Data;
                _modelo.Tipo = transacao.Tipo;
                _modelo.Recorrencia = transacao.Recorrencia;
                _modelo.Pago = transacao.Pago;
                _modelo.Observacao = transacao.Observacao;
                _modelo.CategoriaId = transacao.CategoriaId;
                _modelo.CartaoId = transacao.CartaoId;
                _modelo.Itens = ImportacaoFaturaCsvApresentacao.CopiarItens(transacao.Itens);
                _data = transacao.Data;
                _dataOriginal = transacao.Data;
                _periodoOriginalFechado = await FechamentoService.EstaFechadoAsync(transacao.Data.Month, transacao.Data.Year);
            }
            else
            {
                FluxoLancamento.IniciarNovo(_modelo, DateTime.Today);
                _data = _modelo.Data;
                GarantirCategoriaValida();
                Snackbar.Add("Lançamento não encontrado.", Severity.Warning);
                Voltar();
            }
        }
        else
        {
            var copia = Rascunho.Consumir();
            if (copia is not null)
            {
                AplicarModelo(copia);
                Snackbar.Add("Cópia da fatura pronta. Revise e salve.", Severity.Info);
            }
            else
            {
                FluxoLancamento.IniciarNovo(_modelo, DateTime.Today);
                _data = _modelo.Data;
                GarantirCategoriaValida();
            }
        }

        if (!Id.HasValue)
            AplicarTipoDaCategoria();
        GarantirItemCategoriaValida();
        GarantirCartaoValido();
        await VerificarPeriodoAsync();
        _carregando = false;
        LigarCasco();
    }

    private void AplicarModelo(TransacaoFormModel origem)
    {
        _modelo.Descricao = origem.Descricao;
        _modelo.Valor = origem.Valor;
        _modelo.Data = origem.Data;
        _modelo.Tipo = origem.Tipo;
        _modelo.Recorrencia = origem.Recorrencia;
        _modelo.Pago = origem.Pago;
        _modelo.Observacao = origem.Observacao;
        _modelo.CategoriaId = origem.CategoriaId;
        _modelo.CartaoId = origem.CartaoId;
        _modelo.Itens = origem.Itens;
        _data = origem.Data;
    }

    private Task AlterarDataFaturaAsync(DateTime? data)
    {
        _data = data;
        return VerificarPeriodoAsync();
    }

    private void Voltar() => NavigationManager.NavigateTo(ConsultaMesLancamentos.Rota(MesConsulta));

    private async Task SalvarSePermitidoAsync(EditContext context)
    {
        if (_painel?.SheetAberto == true)
            return;

        if (!context.Validate())
            return;

        await SalvarAsync();
    }

    private async Task ExcluirAsync()
    {
        if (!Id.HasValue)
            return;

        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Excluir lançamento", "Tem certeza que deseja excluir este lançamento?", yesText: "Excluir", cancelText: "Cancelar");
        if (confirmado != true)
            return;

        try
        {
            await TransacaoService.ExcluirAsync(Id.Value);
            Snackbar.Add("Lançamento excluído", Severity.Success);
            Voltar();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private void DuplicarAsync()
    {
        if (!Id.HasValue)
            return;

        _modelo.Data = _data ?? DateTime.Today;
        Rascunho.GuardarCopia(_modelo);
        NavigationManager.NavigateTo(ConsultaMesLancamentos.Rota(MesConsulta, "/lancamentos/novo"));
    }

    private void LigarCasco()
    {
        if (!UsarLayoutFatura)
        {
            if (_cascoLigado)
            {
                Casco.Definir(null);
                _cascoLigado = false;
            }

            return;
        }

        _barraCache ??= BarraFatura;
        if (!_cascoLigado)
        {
            Casco.Definir(_barraCache);
            _cascoLigado = true;
            return;
        }

        Casco.Atualizar();
    }

    private void AtualizarCasco() => LigarCasco();

    public void Dispose()
    {
        if (_cascoLigado)
            Casco.Definir(null);
    }

    private async Task VerificarPeriodoAsync()
    {
        var data = _data ?? DateTime.Today;
        _periodoDataFechado = await FechamentoService.EstaFechadoAsync(data.Month, data.Year);
        LigarCasco();
    }

    private void OnCategoriaChanged(int categoriaId)
    {
        if (categoriaId == _modelo.CategoriaId)
            return;

        var categoriaAnterior = _modelo.CategoriaId;
        var tipoGravado = _modelo.Tipo;
        _modelo.CategoriaId = categoriaId;
        if (_categoriaSelecionada is not null)
        {
            _modelo.Tipo = FluxoLancamento.TipoNaEdicao(
                categoriaAnterior,
                categoriaId,
                tipoGravado,
                _categoriaSelecionada.TipoPadrao);
        }

        GarantirItemCategoriaValida();
        GarantirCartaoValido();
        LigarCasco();
    }

    private void AplicarTipoDaCategoria()
    {
        if (_categoriaSelecionada is null)
            return;

        _modelo.Tipo = FluxoLancamento.TipoNaCriacao(_categoriaSelecionada.TipoPadrao);
    }

    private void GarantirCartaoValido()
    {
        if (!EhCartaoCredito)
        {
            _modelo.CartaoId = null;
            return;
        }

        _modelo.CartaoId = FluxoLancamento.CartaoInicial(
            _modelo.CartaoId,
            CartoesCreditoDisponiveis.Select(c => c.Id).ToList());
    }

    private void GarantirCategoriaValida()
    {
        if (_modelo.CategoriaId <= 0)
            return;

        var filtradas = CategoriasFiltradas.ToList();
        if (filtradas.Count == 0)
            return;

        if (filtradas.Any(c => c.Id == _modelo.CategoriaId))
            return;

        _modelo.CategoriaId = FluxoLancamento.CategoriaInicial(
            filtradas.Select(c => new FluxoLancamento.CategoriaDeLancamento(
                c.Id, c.Nome, c.PermiteItensFatura, c.TipoPadrao)).ToList(),
            _modelo.Tipo);
    }

    private void GarantirItemCategoriaValida()
    {
        if (!CategoriasDosItens.Any(c => c.Id == _itemCategoriaId))
            _itemCategoriaId = CategoriasDosItens.FirstOrDefault()?.Id ?? 0;
    }

    private double PercentualClassificado =>
        FaturaCartaoEditor.PercentualClassificado(_modelo.Valor, SomaItens);

    private static string LegendaItem(ItemLancamentoFormModel item, Categoria? categoria)
    {
        var natureza = RotuloNatureza(item);
        var nome = categoria?.Nome;
        if (!ItensFaturaInclusao.TemDescritivo(item.Descritivo) || string.IsNullOrWhiteSpace(nome))
            return natureza;

        return $"{nome} · {natureza}";
    }

    private static string RotuloNatureza(ItemLancamentoFormModel item) => item.Natureza switch
    {
        NaturezaItemLancamento.Parcelada => $"Parcela {item.ParcelaAtual}/{item.TotalParcelas}",
        NaturezaItemLancamento.Assinatura => "Assinatura",
        _ => "Avulsa"
    };

    private void AlterarNatureza(NaturezaItemLancamento natureza)
    {
        _itemNatureza = natureza;
        _erroItem = null;
        if (natureza == NaturezaItemLancamento.Parcelada)
        {
            _itemParcelaAtual ??= 1;
            return;
        }

        _itemParcelaAtual = null;
        _itemTotalParcelas = null;
    }

    private async Task IncluirItemAsync()
    {
        GarantirItemCategoriaValida();

        if (_itemCategoriaId <= 0)
        {
            _erroItem = "Selecione a despesa.";
            return;
        }

        if (_itemValor <= 0)
        {
            _erroItem = "Informe o valor do item.";
            await _valorCampo.FocusAsync();
            return;
        }

        if (_itemNatureza == NaturezaItemLancamento.Parcelada
            && (_itemParcelaAtual is not > 0 || _itemTotalParcelas is not > 0 || _itemParcelaAtual > _itemTotalParcelas))
        {
            _erroItem = "Informe a parcela atual e o total, por exemplo 2 de 12.";
            return;
        }

        try
        {
            var nomeCategoria = _categorias.FirstOrDefault(c => c.Id == _itemCategoriaId)?.Nome ?? string.Empty;
            ItensFaturaInclusao.Acrescentar(
                _modelo.Itens,
                _itemCategoriaId,
                nomeCategoria,
                _itemValor,
                _itemNatureza,
                _itemParcelaAtual,
                _itemTotalParcelas,
                _itemDescritivo);
        }
        catch (InvalidOperationException ex)
        {
            _erroItem = ex.Message;
            return;
        }

        _itemValor = 0;
        _itemDescritivo = null;
        _linhaEditando = null;
        _erroItem = null;
        await _valorCampo.FocusAsync();
    }

    private void EditarLinha(ItemLancamentoFormModel item)
    {
        _linhaEditando = item;
        _erroItem = null;
    }

    private void ConfirmarEdicao(ItemLancamentoFormModel item)
    {
        if (item.Valor <= 0)
        {
            _erroItem = "Informe o valor do item.";
            return;
        }

        try
        {
            item.Descritivo = ItensFaturaInclusao.NormalizarDescritivo(item.Descritivo);
        }
        catch (InvalidOperationException ex)
        {
            _erroItem = ex.Message;
            return;
        }

        _linhaEditando = null;
        _erroItem = null;
    }

    private void RemoverLinha(ItemLancamentoFormModel item)
    {
        if (_linhaEditando == item)
            _linhaEditando = null;
        _modelo.Itens.Remove(item);
    }

    private async Task SalvarAsync()
    {
        _modelo.Data = _data ?? DateTime.Today;
        if (!MostrarItens)
            _modelo.Itens.Clear();
        if (!EhCartaoCredito)
            _modelo.CartaoId = null;

        try
        {
            if (Id.HasValue)
                await TransacaoService.AtualizarAsync(Id.Value, _modelo);
            else
                await TransacaoService.CriarAsync(_modelo);

            Snackbar.Add("Lançamento salvo com sucesso", Severity.Success);
            Voltar();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (DbUpdateException ex)
        {
            Log.Error(
                "Falha ao gravar o lançamento. Tipo: {Tipo}",
                VarreduraPlanilhaExportada.TipoDaFalha(ex));
            Snackbar.Add(FalhaDeGravacao.MensagemLancamento, Severity.Error);
        }
    }
}
