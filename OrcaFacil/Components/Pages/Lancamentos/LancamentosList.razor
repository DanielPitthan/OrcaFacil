@page "/lancamentos"
@using System.Globalization
@implements IDisposable
@inject ITransacaoService TransacaoService
@inject ICategoriaService CategoriaService
@inject IFechamentoService FechamentoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CascoNavegacao Casco

<div class="of-lancamentos">
    @if (_buscaAberta)
    {
        <div class="of-busca">
            <MudTextField @bind-Value="_busca" @bind-Value:after="AtualizarPainel" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Descrição"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                          aria-label="Buscar por descrição" />
        </div>
    }

    @if (_painel is null)
    {
        <MudProgressCircular Indeterminate="true" aria-label="Carregando lançamentos" />
    }
    else
    {
        <MonthSwitcher Nome="@_painel.NomeMes" Aberto="@(!_fechado)" MesAlterado="MudarMes">
            <Acoes>
                @if (_despesasComAviso.Count > 0)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.NotificationsActive"
                                   aria-label="@($"{_despesasComAviso.Count} despesas com aviso")"
                                   Color="Color.Warning" OnClick="@(() => _mostrarAvisos = !_mostrarAvisos)" />
                }
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AriaLabel="Ações do mês"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Disabled="@(_fechado || !_temDespesasParaTrazer)" OnClick="TrazerDespesasAsync">Trazer mês anterior</MudMenuItem>
                    <MudMenuItem OnClick="AlternarFechamentoAsync">@(_fechado ? "Reabrir mês" : "Fechar mês")</MudMenuItem>
                </MudMenu>
            </Acoes>
        </MonthSwitcher>

        @if (_mostrarAvisos && _despesasComAviso.Count > 0)
        {
            <div class="of-avisos">
            <MudAlert Severity="Severity.Warning" Dense="true" ShowCloseIcon="true"
                      CloseIconClicked="@(() => _mostrarAvisos = false)">
                @foreach (var despesa in _despesasComAviso.Take(5))
                {
                    <div>@despesa.Categoria?.Icone @despesa.Descricao — @despesa.Valor.ToString("C") (@despesa.Data.ToString("dd/MM/yyyy"))</div>
                }
                @if (_despesasComAviso.Count > 5)
                {
                    <MudText Typo="Typo.caption">e mais @(_despesasComAviso.Count - 5) despesa(s)...</MudText>
                }
            </MudAlert>
            </div>
        }

        <MonthSummaryCard Sobra="@_painel.Sobra" TextoSobra="@_painel.TextoSobra"
                          TextoReceitas="@_painel.TextoReceitas" TextoDespesas="@_painel.TextoDespesas"
                          TextoPagas="@_painel.TextoPagas" TextoAPagar="@_painel.TextoAPagar"
                          TextoReceitaComprometida="@_painel.TextoReceitaComprometida"
                          TextoDespesasPagas="@_painel.TextoDespesasPagas"
                          ProgressoReceita="@_painel.ProgressoReceitaComprometida"
                          ReceitaCritica="@_painel.ReceitaComprometidaCritica"
                          ProgressoPagas="@_painel.ProgressoDespesasPagas" />

        <MonthEvolutionChart Dados="_painel" />

        <FilterChipBar T="FiltroListaLancamento" Valor="_filtro" ValorChanged="AlterarFiltro"
                       Opcoes="_opcoesFiltro" AriaLabel="Filtrar por tipo"
                       Categorias="_opcoesCategoria" CategoriasSelecionadas="_categoriasFiltro"
                       CategoriasSelecionadasChanged="AlterarCategorias" />

        <GroupedEntryList Grupos="_painel.Grupos" Quantidade="_painel.QuantidadeFiltrada"
                          MesSemLancamentos="_painel.MesSemLancamentos" NomeMes="@_painel.NomeMes"
                          PermiteAlterar="@(!_fechado)" NovoDesabilitado="_fechado"
                          OnAbrir="AbrirEdicao" OnExcluir="ExcluirAsync" OnAlternarPago="AlternarPagoAsync"
                          OnNovo="NovoLancamento" />
    }
</div>

<div class="of-fab">
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="Novo lançamento"
            Disabled="@(_carregando || _fechado)" OnClick="NovoLancamento" aria-label="Novo lançamento" />
</div>

@code {
    private static readonly IReadOnlyList<OpcaoFiltro<FiltroListaLancamento>> _opcoesFiltro =
    [
        new(FiltroListaLancamento.Todos, "Todos"),
        new(FiltroListaLancamento.Despesas, "Despesas"),
        new(FiltroListaLancamento.Receitas, "Receitas"),
        new(FiltroListaLancamento.APagar, "A pagar")
    ];

    private bool _carregando = true;
    private bool _cascoLigado;
    private bool _buscaAberta;
    private bool _fechado;
    private bool _temDespesasParaTrazer;
    private bool _mostrarAvisos;
    private string _busca = "";
    private FiltroListaLancamento _filtro = FiltroListaLancamento.Todos;
    private readonly HashSet<int> _categoriasFiltro = [];
    private List<Transacao> _transacoes = [];
    private List<Transacao> _despesasComAviso = [];
    private List<Categoria> _categorias = [];
    private List<OpcaoCategoriaFiltro> _opcoesCategoria = [];
    private PainelLancamentosMes? _painel;
    private DateTime _mesReferencia = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool _consultaAplicada;
    private string? _mesNaUrl;

    [SupplyParameterFromQuery(Name = "mes")]
    public string? MesConsulta { get; set; }

    private RenderFragment BarraLancamentos => @<text>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Abrir menu" OnClick="AbrirMenu" />
        <span class="of-appbar-titulo">Lançamentos</span>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit"
                       aria-label="Buscar por descrição" aria-pressed="@_buscaAberta" OnClick="AlternarBusca" />
    </text>;

    protected override async Task OnInitializedAsync()
    {
        Casco.Definir(BarraLancamentos);
        _cascoLigado = true;
        _categorias = await CategoriaService.ListarAsync();
        _opcoesCategoria = _categorias
            .Select(c => new OpcaoCategoriaFiltro(c.Id, c.Nome, c.Icone))
            .ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_consultaAplicada && _mesNaUrl == MesConsulta)
            return;

        _consultaAplicada = true;
        _mesNaUrl = MesConsulta;
        _mesReferencia = ConsultaMesLancamentos.Resolver(MesConsulta, DateTime.Today);
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            var filtro = new FiltroLancamentoDto
            {
                Inicio = _mesReferencia,
                Fim = _mesReferencia.AddMonths(1).AddTicks(-1)
            };
            _transacoes = await TransacaoService.ListarAsync(filtro);
            _fechado = await FechamentoService.EstaFechadoAsync(_mesReferencia.Month, _mesReferencia.Year);
            _temDespesasParaTrazer = await TransacaoService.ExistemDespesasParaTrazerAsync(_mesReferencia.Month, _mesReferencia.Year);
            _despesasComAviso = await TransacaoService.ObterDespesasComAvisoAsync();
            AtualizarPainel();
        }
        finally
        {
            _carregando = false;
        }
    }

    private void AtualizarPainel()
    {
        _painel = PainelLancamentosMes.Montar(
            _transacoes,
            _mesReferencia,
            DateTime.Today,
            _filtro,
            _categoriasFiltro,
            _busca,
            CultureInfo.CurrentCulture);
    }

    private void MudarMes(int delta)
    {
        var mes = _mesReferencia.AddMonths(delta);
        NavigationManager.NavigateTo($"/lancamentos?mes={mes.ToString("yyyy-MM", CultureInfo.InvariantCulture)}", replace: true);
    }

    private void AlterarFiltro(FiltroListaLancamento filtro)
    {
        _filtro = filtro;
        AtualizarPainel();
    }

    private void AlterarCategorias(IReadOnlySet<int> categorias)
    {
        _categoriasFiltro.Clear();
        foreach (var id in categorias)
            _categoriasFiltro.Add(id);
        AtualizarPainel();
    }

    private void AbrirMenu() => Casco.SolicitarMenu();

    private void AlternarBusca()
    {
        _buscaAberta = !_buscaAberta;
        if (!_buscaAberta && !string.IsNullOrEmpty(_busca))
        {
            _busca = "";
            AtualizarPainel();
        }

        Casco.Atualizar();
    }

    private void NovoLancamento()
    {
        if (_fechado)
        {
            Snackbar.Add("Mês fechado. Reabra o período para incluir lançamentos.", Severity.Info);
            return;
        }

        NavigationManager.NavigateTo($"/lancamentos/novo?mes={_mesReferencia.ToString("yyyy-MM", CultureInfo.InvariantCulture)}");
    }

    private void AbrirEdicao(int id)
    {
        if (_fechado)
        {
            Snackbar.Add("Mês fechado. Reabra o período para editar lançamentos.", Severity.Info);
            return;
        }

        NavigationManager.NavigateTo($"/lancamentos/editar/{id}?mes={_mesReferencia.ToString("yyyy-MM", CultureInfo.InvariantCulture)}");
    }

    private async Task TrazerDespesasAsync()
    {
        try
        {
            var quantidade = await TransacaoService.TrazerDespesasDoMesAnteriorAsync(_mesReferencia.Month, _mesReferencia.Year);
            Snackbar.Add(quantidade == 1 ? "1 despesa trazida do mês anterior" : $"{quantidade} despesas trazidas do mês anterior", Severity.Success);
            await CarregarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task AlternarFechamentoAsync()
    {
        var periodo = _mesReferencia.ToString("MMMM/yyyy");
        var confirmado = await DialogService.ShowMessageBoxAsync(
            _fechado ? "Reabrir mês" : "Fechar mês",
            _fechado
                ? $"Reabrir {periodo}? Os lançamentos voltarão a poder ser alterados."
                : $"Fechar {periodo}? Nenhum lançamento do período poderá ser incluído, alterado ou excluído até a reabertura.",
            yesText: _fechado ? "Reabrir" : "Fechar", cancelText: "Cancelar");

        if (confirmado != true)
            return;

        _fechado = await FechamentoService.AlternarAsync(_mesReferencia.Month, _mesReferencia.Year);
        Snackbar.Add(_fechado ? $"{periodo} fechado" : $"{periodo} reaberto", Severity.Success);
    }

    private async Task AlternarPagoAsync(int id)
    {
        var transacao = _transacoes.FirstOrDefault(t => t.Id == id);
        if (transacao is null || transacao.Tipo != TipoTransacao.Despesa)
            return;

        try
        {
            await TransacaoService.MarcarComoPagoAsync(transacao.Id, !transacao.Pago);
            transacao.Pago = !transacao.Pago;
            _despesasComAviso = await TransacaoService.ObterDespesasComAvisoAsync();
            AtualizarPainel();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Excluir lançamento", "Tem certeza que deseja excluir este lançamento?", yesText: "Excluir", cancelText: "Cancelar");

        if (confirmado != true)
            return;

        try
        {
            await TransacaoService.ExcluirAsync(id);
            Snackbar.Add("Lançamento excluído", Severity.Success);
            await CarregarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    public void Dispose()
    {
        if (_cascoLigado)
            Casco.Definir(null);
    }
}
