@page "/dashboard"
@using System.Globalization
@implements IDisposable
@inject ITransacaoService TransacaoService
@inject IOrcamentoService OrcamentoService
@inject IMetaService MetaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject CascoNavegacao Casco

<div class="of-dashboard">
    @if (_erro is not null && _painel is null)
    {
        <p class="of-dashboard-erro">@_erro</p>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CarregarAsync">Tentar de novo</MudButton>
    }
    else if (_painel is null)
    {
        <MudSkeleton Height="220px" Class="of-dashboard-esqueleto" />
        <MudSkeleton Height="120px" Class="of-dashboard-esqueleto" />
        <MudSkeleton Height="180px" Class="of-dashboard-esqueleto" />
    }
    else
    {
        <MonthSummaryCard Sobra="@_painel.Saldo" TextoSobra="@_painel.TextoSaldo"
                          RotuloSaldo="@_painel.RotuloSaldo" RotuloAcessivel="@_painel.RotuloAcessivelResumo"
                          TextoReceitas="@_painel.TextoReceitas" TextoDespesas="@_painel.TextoDespesas"
                          TextoPagas="@_painel.TextoPagas" TextoAPagar="@_painel.TextoAPagar"
                          TextoReceitaComprometida="@_painel.TextoReceitaComprometida"
                          TextoDespesasPagas="@_painel.TextoDespesasPagas"
                          ProgressoReceita="@_painel.ProgressoReceita" ReceitaCritica="@_painel.ReceitaCritica"
                          ProgressoPagas="@_painel.ProgressoPagas" ExibirPagamento="@_painel.ExibirPagamento">
            <ConteudoTopo>
                <PeriodSelector Valor="_periodo" ValorChanged="AlterarPeriodo" />
            </ConteudoTopo>
        </MonthSummaryCard>

        <SectionHeader Titulo="Orçamentos" Valor="@_painel.TextoContagemOrcamentos" />
        <BudgetProgressList Itens="@_painel.Orcamentos" />

        <SectionHeader Titulo="Despesas por categoria" Valor="@_painel.TextoTotalCategorias" />
        <CategoryBreakdown Visiveis="@_painel.CategoriasVisiveis" Ocultas="@_painel.CategoriasOcultas"
                           Barra="@_painel.FatiasBarra" Outras="@_painel.Outras"
                           RotuloAcessivel="@_painel.RotuloAcessivelCategorias" />

        <SectionHeader Titulo="Receitas × despesas" />
        <MonthlyComparisonChart Meses="@_painel.Meses" DestacarUltimo="@_painel.DestacarUltimoRotulo"
                                NotaLacuna="@_painel.NotaLacuna" PassoEixoY="@_painel.PassoEixoY"
                                RotuloAcessivel="@_painel.RotuloAcessivelGrafico" />

        <SectionHeader Titulo="Metas de economia" />
        @if (_painel.Metas.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Flag" Mensagem="Nenhuma meta cadastrada" />
        }
        else
        {
            @foreach (var meta in _painel.Metas)
            {
                <GoalProgress Nome="@meta.Nome" TextoPercentual="@meta.TextoPercentual" Progresso="@meta.Progresso" />
            }
        }
    }
</div>

@code {
    private bool _cascoLigado;
    private string? _erro;
    private PeriodoResumo _periodo = PeriodoResumo.EsteMes;
    private PainelInicio? _painel;
    private ResumoMensalDto _mes = new();
    private ResumoAcumuladoDto _acumulado = new();
    private List<Transacao> _despesas = [];
    private List<TendenciaMensalDto> _tendencia = [];
    private List<AlertaOrcamentoDto> _alertas = [];
    private List<Meta> _metas = [];

    private RenderFragment Barra => @<text>
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Voltar" OnClick="Voltar" />
        <span class="of-appbar-titulos">
            <span class="of-appbar-titulo">Dashboard</span>
            <span class="of-appbar-sub">@_painel?.NomeMes</span>
        </span>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        Casco.Definir(Barra);
        _cascoLigado = true;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _erro = null;
        _painel = null;
        try
        {
            var hoje = DateTime.Today;
            _mes = await TransacaoService.ObterResumoMensalAsync(hoje.Month, hoje.Year);
            _acumulado = await TransacaoService.ObterResumoAcumuladoAsync();
            _despesas = await TransacaoService.ListarAsync(new FiltroLancamentoDto { Tipo = TipoTransacao.Despesa });
            _tendencia = await TransacaoService.ObterTendenciaMensalAsync(PainelInicio.MaximoMesesGrafico);
            _alertas = await OrcamentoService.ObterAlertasAsync(hoje.Month, hoje.Year);
            _metas = await MetaService.ListarAsync();
            Remontar();
        }
        catch (Exception)
        {
            _erro = "Não foi possível carregar o dashboard.";
        }
    }

    private void AlterarPeriodo(PeriodoResumo periodo)
    {
        if (periodo == _periodo)
            return;
        _periodo = periodo;
        Remontar();
    }

    private void Remontar()
    {
        _painel = PainelInicio.Montar(new EntradaPainelInicio(
            _periodo,
            _mes,
            _acumulado,
            CategoriasDoPeriodo(),
            _tendencia,
            _alertas,
            _metas,
            DateTime.Today), CultureInfo.CurrentCulture);
        Casco.Atualizar();
    }

    private IReadOnlyList<EntradaCategoria> CategoriasDoPeriodo()
    {
        IEnumerable<Transacao> fonte = _despesas;
        if (_periodo == PeriodoResumo.EsteMes)
        {
            var inicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var fim = inicio.AddMonths(1).AddTicks(-1);
            fonte = _despesas.Where(t => t.Data >= inicio && t.Data <= fim);
        }

        return PainelInicio.Classificar(fonte.Select(t => new LancamentoCategoria(
            t.Categoria?.Nome ?? "Sem categoria",
            t.Valor,
            t.Itens?.Select(i => new EntradaCategoria(i.Categoria?.Nome ?? "Sem categoria", i.Valor)).ToList())));
    }

    private void Voltar() => Navigation.NavigateTo("/");

    public void Dispose()
    {
        if (_cascoLigado)
            Casco.Definir(null);
    }
}
