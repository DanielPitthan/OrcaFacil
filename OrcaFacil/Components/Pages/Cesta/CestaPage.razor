@page "/cesta"
@using Microsoft.EntityFrameworkCore
@using OrcaFacil.Core.Llm
@using OrcaFacil.Core.Services
@implements IDisposable
@inject ICestaService CestaService
@inject ICategoriaService CategoriaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IFotoPerfilService Fotos
@inject ICofreChaveApi Cofre
@inject IConfiguracaoService Configuracao
@inject IPreferenciasSimples Preferencias
@inject ClienteMensagens Cliente

<div class="pro-sticky-header">
    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.subtitle1"><b>Cesta Básica</b></MudText>
        <div class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="@(() => MudarMes(-1))" aria-label="Mês anterior" />
            <MudText Typo="Typo.body1" Style="min-width:120px;text-align:center;">@_referencia.ToString("MMMM/yyyy")</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="@(() => MudarMes(1))" aria-label="Próximo mês" />
        </div>
    </div>
</div>

<LeituraComprovantePainel Exibicao="_exibicao" Comprovante="_comprovante" Ocupado="@(_lendo || _previaAberta)"
                           TentarDeNovo="TentarDeNovoAsync" AbrirInteligenciaArtificial="AbrirInteligencia"
                           AbrirPrevia="AbrirPreviaAsync" />

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mb-2" @bind-ActivePanelIndex="_aba">
    <MudTabPanel Text="Compras" Icon="@Icons.Material.Filled.Receipt">
        <div class="pro-fab-spacer pa-2">
            @if (_carregando)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_compras.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.ShoppingCart" Mensagem="Nenhuma compra neste mês"
                            Subtitulo="Registre os preços de um local ou traga a cesta do mês anterior" />
            }
            else
            {
                @foreach (var compra in _compras)
                {
                    var total = compra.Itens.Sum(i => i.Preco);
                    var bolso = CestaDespesaRegras.CustoDeBolso(total, compra.ValorBeneficio);
                    <MudPaper Outlined="true" Class="pa-3 mb-3">
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.subtitle1"><b>@(compra.LocalCompra?.Nome ?? "Local")</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@compra.Data.ToString("dd/MM/yyyy")</MudText>
                            </div>
                            <div class="d-flex">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" aria-label="Editar compra"
                                               OnClick="@(() => EditarCompraAsync(compra))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Excluir compra"
                                               OnClick="@(() => ExcluirCompraAsync(compra))" />
                            </div>
                        </div>
                        @foreach (var item in compra.Itens.OrderBy(i => i.Ordem))
                        {
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">@(item.Produto?.Nome ?? "Produto")</MudText>
                                <MudText Typo="Typo.body2">@item.Preco.ToString("C")</MudText>
                            </div>
                        }
                        <MudDivider Class="my-2" />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Total</MudText>
                            <MudText Typo="Typo.body2"><b>@total.ToString("C")</b></MudText>
                        </div>
                        @if (compra.ValorBeneficio > 0 && compra.TipoCartaoBeneficio is { } tipo)
                        {
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">@(compra.CartaoBeneficio?.Rotulo ?? tipo.Rotulo())</MudText>
                                <MudText Typo="Typo.body2">@compra.ValorBeneficio.ToString("C")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">Custo de bolso</MudText>
                                <MudText Typo="Typo.body2">@bolso.ToString("C")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">Aproveitamento</MudText>
                                <MudText Typo="Typo.body2">@CestaDespesaRegras.AproveitamentoPercentual(total, compra.ValorBeneficio).ToString("0.##")%</MudText>
                            </div>
                        }
                        @if (compra.ValorDinheiro > 0)
                        {
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">Dinheiro</MudText>
                                <MudText Typo="Typo.body2">@compra.ValorDinheiro.ToString("C")</MudText>
                            </div>
                        }
                        @if (compra.ValorCartaoCredito > 0)
                        {
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">@(compra.CartaoCredito?.Rotulo ?? "Cartão de crédito")</MudText>
                                <MudText Typo="Typo.body2">@compra.ValorCartaoCredito.ToString("C")</MudText>
                            </div>
                        }
                    </MudPaper>
                }
            }
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Comparativo" Icon="@Icons.Material.Filled.CompareArrows">
        <div class="pro-fab-spacer pa-2">
            @if (_carregando)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <MudAlert Severity="@(_comparativo.Disponivel ? Severity.Success : Severity.Info)" Dense="true" Class="mb-3">
                    @_comparativo.Mensagem
                </MudAlert>

                @if (_comparativo.Evolucao.Mensagem is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@_comparativo.Evolucao.Mensagem</MudAlert>
                }

                @if (_comparativo.Beneficios.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Cartão de benefício</MudText>
                    @foreach (var beneficio in _comparativo.Beneficios)
                    {
                        <MudPaper Outlined="true" Class="pa-3 mb-2">
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.body1"><b>@beneficio.LocalNome</b></MudText>
                                @if (beneficio.RendeMais)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Rende mais</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @beneficio.Tipo.Rotulo() · @beneficio.ValorBeneficio.ToString("C") de @beneficio.TotalCesta.ToString("C")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Aproveitamento @beneficio.AproveitamentoPercentual.ToString("0.##")% · custo de bolso @beneficio.CustoDeBolso.ToString("C")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Cada R$ 1,00 do benefício compra @beneficio.Rendimento.ToString("C") de produtos
                            </MudText>
                        </MudPaper>
                    }
                    @if (_comparativo.Beneficios.Count >= 2 && _comparativo.Beneficios.FirstOrDefault(b => b.RendeMais) is { } melhor)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            O benefício rende mais no @melhor.LocalNome: cada R$ 1,00 compra @melhor.Rendimento.ToString("C") de produtos
                            (aproveitamento de @melhor.AproveitamentoPercentual.ToString("0.##")%).
                        </MudAlert>
                    }
                }

                @if (_comparativo.Locais.Any(l => l.TotalComparavel is not null))
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">Cesta comparável por local</MudText>
                    @foreach (var local in _comparativo.Locais.Where(l => l.TotalComparavel is not null).OrderBy(l => l.TotalComparavel))
                    {
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2">
                                @local.Nome
                                @if (local.MaisBarato)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Mais barato</MudChip>
                                }
                            </MudText>
                            <MudText Typo="Typo.body2"><b>@local.TotalComparavel!.Value.ToString("C")</b></MudText>
                        </div>
                    }
                }

                @if (_comparativo.Produtos.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1">Preço mais recente de cada produto em cada local.</MudText>
                    <div style="overflow-x:auto;">
                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    @foreach (var local in _comparativo.Locais)
                                    {
                                        <th>@local.Nome</th>
                                    }
                                    <th>Economia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var linha in _comparativo.Produtos)
                                {
                                    <tr>
                                        <td>@linha.Nome</td>
                                        @foreach (var preco in linha.Precos)
                                        {
                                            <td>
                                                @if (preco.Preco is null)
                                                {
                                                    <span>—</span>
                                                }
                                                else if (preco.MaisBarato)
                                                {
                                                    <b>@preco.Preco.Value.ToString("C")</b>
                                                }
                                                else
                                                {
                                                    @preco.Preco.Value.ToString("C")
                                                }
                                            </td>
                                        }
                                        <td>
                                            @if (linha.EconomiaReais is decimal economia && economia > 0)
                                            {
                                                @($"{economia.ToString("C")} ({linha.EconomiaPercentual?.ToString("0.##")}%)")
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            }
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Produtos" Icon="@Icons.Material.Filled.ShoppingBasket">
        <div class="pro-fab-spacer">
            <div class="pa-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Importação CSV: colunas Produto e Categoria, separadas por ponto e vírgula. Se vier só o nome, a categoria é escolhida na hora.
                </MudText>
            </div>
            @if (_produtos.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.ShoppingBasket" Mensagem="Nenhum produto cadastrado"
                            Subtitulo="Ex.: Arroz, Feijão, Detergente" />
            }
            else
            {
                <MudList T="ProdutoCesta" Dense="true">
                    @foreach (var produto in _produtos)
                    {
                        <MudListItem T="ProdutoCesta">
                            <div class="d-flex justify-space-between align-center" style="width:100%">
                                <div>
                                    <MudText Typo="Typo.body1">
                                        @produto.Nome
                                        @if (!produto.Ativo)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Inativo</MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@produto.Categoria?.Icone @produto.Categoria?.Nome</MudText>
                                </div>
                                <div class="d-flex">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" aria-label="Editar produto"
                                                   OnClick="@(() => EditarProdutoAsync(produto))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Excluir produto"
                                                   OnClick="@(() => ExcluirProdutoAsync(produto))" />
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Locais" Icon="@Icons.Material.Filled.Store">
        <div class="pro-fab-spacer">
            @if (_locais.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.Store" Mensagem="Nenhum local cadastrado"
                            Subtitulo="Ex.: Boa Supermercado, Fort Atacadista" />
            }
            else
            {
                <MudList T="LocalCompra" Dense="true">
                    @foreach (var local in _locais)
                    {
                        <MudListItem T="LocalCompra">
                            <div class="d-flex justify-space-between align-center" style="width:100%">
                                <MudText Typo="Typo.body1">
                                    @local.Nome
                                    @if (!local.Ativo)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Inativo</MudChip>
                                    }
                                </MudText>
                                <div class="d-flex">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" aria-label="Editar local"
                                                   OnClick="@(() => EditarLocalAsync(local))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Excluir local"
                                                   OnClick="@(() => ExcluirLocalAsync(local))" />
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </div>
    </MudTabPanel>
</MudTabs>

<FabMenu>
    <FabMenuItem Text="Nova compra" Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Primary" Click="NovaCompraAsync" />
    <FabMenuItem Text="Ler comprovante" Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Secondary" Disabled="@_lendo" Click="IniciarLeituraAsync" />
    <FabMenuItem Text="Trazer cesta do mês anterior" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary" Click="TrazerMesAnteriorAsync" />
    <FabMenuItem Text="Novo produto" Icon="@Icons.Material.Filled.ShoppingBasket" Color="Color.Secondary" Click="NovoProdutoAsync" />
    <FabMenuItem Text="Importar CSV" Icon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Disabled="@_importando" Click="ImportarProdutosAsync" />
    <FabMenuItem Text="Novo local" Icon="@Icons.Material.Filled.Store" Color="Color.Secondary" Click="NovoLocalAsync" />
</FabMenu>

@code {
    private readonly CancellationTokenSource _pagina = new();

    private bool _carregando = true;
    private bool _importando;
    private bool _lendo;
    private bool _previaAberta;
    private bool _descartada;
    private int _geracao;
    private int _aba;
    private byte[]? _jpeg;
    private ExibicaoLeituraComprovante? _exibicao;
    private ComprovanteNormalizado? _comprovante;
    private IReadOnlyList<ItemSaidaComprovante> _saidas = [];
    private PreviaComprovante? _previa;
    private DateTime _referencia = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<CompraCesta> _compras = new();
    private List<ProdutoCesta> _produtos = new();
    private List<LocalCompra> _locais = new();
    private List<Categoria> _categorias = new();
    private ComparativoCesta _comparativo = new();

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    public void Dispose()
    {
        _descartada = true;
        _jpeg = null;
        _comprovante = null;
        _saidas = [];
        _previa = null;
        _pagina.Cancel();
        _pagina.Dispose();
    }

    private void AbrirInteligencia() => Navigation.NavigateTo(MensagensLeituraComprovante.RotaInteligencia);

    private async Task IniciarLeituraAsync()
    {
        if (_lendo || _descartada)
            return;

        _lendo = true;
        StateHasChanged();
        try
        {
            await FluxoLeituraAsync();
        }
        catch (OperationCanceledException)
        {
            // Sair da página não é erro e não apaga a chave.
        }
        finally
        {
            LiberarLeitura();
        }
    }

    private async Task FluxoLeituraAsync()
    {
        if (!await ConfirmarAvisoAsync() || _descartada)
            return;

        var impedimento = await TemConfiguracaoAsync();
        if (impedimento is not null)
        {
            if (_descartada)
                return;

            _jpeg = null;
            _comprovante = null;
            _saidas = [];
            _exibicao = impedimento;
            return;
        }

        var origem = await EscolherOrigemAsync();
        if (origem is null || _descartada)
            return;

        await CapturarEEnviarAsync(origem.Value);
    }

    private async Task<ExibicaoLeituraComprovante?> TemConfiguracaoAsync()
    {
        string? chave = null;
        try
        {
            chave = await Cofre.LerAsync(_pagina.Token);
            var efetiva = ChipsInteligencia.Efetiva(
                Configuracao.ProvedorInteligencia,
                Configuracao.UrlInteligencia,
                Configuracao.ModeloInteligencia);
            return MensagensLeituraComprovante.ImpedimentoParaLer(efetiva.Url, efetiva.Modelo, chave);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            return MensagensLeituraComprovante.SemConfiguracao();
        }
        finally
        {
            chave = null;
        }
    }

    private async Task TentarDeNovoAsync()
    {
        if (_lendo || _descartada)
            return;

        _lendo = true;
        StateHasChanged();
        try
        {
            if (_jpeg is { Length: > 0 } jpeg && jpeg.Length <= ClienteMensagens.TamanhoMaximoImagem)
                await EnviarJpegAsync(jpeg);
            else
            {
                _jpeg = null;
                await FluxoLeituraAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Sair da página não é erro e não apaga a chave.
        }
        finally
        {
            LiberarLeitura();
        }
    }

    private void LiberarLeitura()
    {
        if (_descartada)
            return;

        _lendo = false;
        StateHasChanged();
    }

    private async Task<bool> ConfirmarAvisoAsync()
    {
        if (AvisoPrivacidadeComprovante.JaVisto(Preferencias))
            return true;

        var dialog = await DialogService.ShowAsync<AvisoPrivacidadeComprovanteDialog>(
            "Privacidade",
            Opcoes(MaxWidth.ExtraSmall));
        var resultado = await dialog.Result;
        if (resultado is not { Canceled: false })
            return false;

        AvisoPrivacidadeComprovante.MarcarVisto(Preferencias);
        return true;
    }

    private async Task<OrigemFotoComprovante?> EscolherOrigemAsync()
    {
        var dialog = await DialogService.ShowAsync<OrigemFotoComprovanteDialog>(
            "Ler comprovante",
            Opcoes(MaxWidth.ExtraSmall));
        var resultado = await dialog.Result;
        return resultado is { Canceled: false, Data: OrigemFotoComprovante origem } ? origem : null;
    }

    private async Task CapturarEEnviarAsync(OrigemFotoComprovante origem)
    {
        var geracao = ++_geracao;
        try
        {
            var foto = await Fotos.PrepararComprovanteAsync(
                origem == OrigemFotoComprovante.Camera,
                async () =>
                {
                    if (Cancelada(geracao))
                        return;

                    _jpeg = null;
                    _comprovante = null;
                    _saidas = [];
                    _exibicao = MensagensLeituraComprovante.Carregando();
                    await InvokeAsync(StateHasChanged);
                },
                _pagina.Token);
            if (foto.Cancelada || Cancelada(geracao))
                return;

            if (foto.FormatoRecusado)
            {
                _jpeg = null;
                _exibicao = MensagensLeituraComprovante.FormatoNaoConvertido();
                return;
            }

            if (foto.AcimaDoTeto)
            {
                _jpeg = null;
                _exibicao = MensagensLeituraComprovante.FotoAcimaDoTeto();
                return;
            }

            var jpeg = foto.Jpeg;
            if (foto.PedirOutraFoto || jpeg is null || jpeg.Length == 0 || jpeg.Length > ClienteMensagens.TamanhoMaximoImagem)
            {
                _jpeg = null;
                _exibicao = foto.PedirOutraFoto
                    ? MensagensLeituraComprovante.FotoGrandeDemais()
                    : MensagensLeituraComprovante.FotoInvalida();
                return;
            }

            _jpeg = jpeg;
            await EnviarJpegAsync(jpeg, geracao);
        }
        catch (OperationCanceledException)
        {
            // Sair da página não é erro e não apaga a chave.
        }
        catch (Exception ex) when (ex is InvalidOperationException or PermissionException or FeatureNotSupportedException)
        {
            _jpeg = null;
            if (Cancelada(geracao))
                return;

            if (ex.Message is "Este dispositivo não suporta captura de fotos." or "Permissão de câmera negada.")
                Snackbar.Add(ex.Message, Severity.Warning);
            else
                _exibicao = MensagensLeituraComprovante.FotoInvalida();
        }
        catch (Exception)
        {
            _jpeg = null;
            if (!Cancelada(geracao))
                _exibicao = MensagensLeituraComprovante.FotoInvalida();
        }
    }

    private async Task EnviarJpegAsync(byte[] jpeg, int? geracao = null)
    {
        geracao ??= ++_geracao;
        var atual = geracao.Value;
        if (jpeg.Length > ClienteMensagens.TamanhoMaximoImagem)
        {
            _jpeg = null;
            _exibicao = MensagensLeituraComprovante.FotoGrandeDemais();
            return;
        }

        _exibicao = MensagensLeituraComprovante.Carregando();
        _comprovante = null;
        _saidas = [];
        _previa = null;
        StateHasChanged();
        string? chave = null;
        try
        {
            chave = await Cofre.LerAsync(_pagina.Token);
            if (Cancelada(atual))
                return;

            var efetiva = ChipsInteligencia.Efetiva(
                Configuracao.ProvedorInteligencia,
                Configuracao.UrlInteligencia,
                Configuracao.ModeloInteligencia);
            if (string.IsNullOrWhiteSpace(chave))
            {
                _exibicao = MensagensLeituraComprovante.De(
                    ResultadoMensagem.Falha(
                        TipoResultadoMensagem.PedidoInvalido,
                        ResultadoMensagem.TextoChaveNaoInformada),
                    null);
                return;
            }

            if (!MensagensLeituraComprovante.TemUrlModeloEChave(efetiva.Url, efetiva.Modelo, chave))
            {
                _exibicao = MensagensLeituraComprovante.SemConfiguracao();
                return;
            }

            var media = PreparoFotoComprovante.EscolherMediaType(jpeg);
            if (media is null)
            {
                _jpeg = null;
                _exibicao = MensagensLeituraComprovante.FormatoNaoConvertido();
                return;
            }

            var produtosCatalogo = await CestaService.ProdutosCatalogoLeituraAsync(_pagina.Token);
            if (Cancelada(atual))
                return;

            var catalogo = CatalogoPedidoComprovante.Texto(produtosCatalogo);

            var resultado = await Cliente.LerComprovanteAsync(
                efetiva.Url,
                chave,
                efetiva.Modelo,
                media,
                Convert.ToBase64String(jpeg),
                _pagina.Token,
                Configuracao.MaxTokensInteligencia,
                catalogo);
            if (Cancelada(atual))
                return;

            IReadOnlyList<ItemSaidaComprovante> saidas = resultado.Comprovante is null
                ? []
                : CasamentoComprovante.Casar(resultado.Comprovante, _produtos);
            var normalizado = resultado.Comprovante is null
                ? null
                : NormalizadorComprovante.Normalizar(resultado.Comprovante, produtosCatalogo);
            var exibicao = MensagensLeituraComprovante.De(resultado, normalizado);
            _exibicao = exibicao;
            _comprovante = exibicao.Situacao == SituacaoLeituraComprovante.Pronta ? normalizado : null;
            _saidas = _comprovante is null ? [] : saidas;
            _previa = null;
            if (_comprovante is not null)
                _jpeg = null;
        }
        catch (OperationCanceledException)
        {
            // Sair da página não é erro e não apaga a chave.
        }
        catch (Exception)
        {
            if (!Cancelada(atual))
                _exibicao = MensagensLeituraComprovante.De(
                    ResultadoMensagem.Falha(TipoResultadoMensagem.Falha, ResultadoMensagem.TextoFalha),
                    null);
        }
        finally
        {
            chave = null;
            if (atual == _geracao && !_descartada)
                StateHasChanged();
        }

        if (_comprovante is not null && !Cancelada(atual))
            await AbrirPreviaAsync();
    }

    private async Task AbrirPreviaAsync()
    {
        if (_comprovante is null || _descartada || _previaAberta)
            return;

        _previaAberta = true;
        try
        {
            _previa ??= PreviaComprovante.Criar(_comprovante, _locais, _produtos, DataNoMes());
            var parametros = new DialogParameters<PreviaComprovanteDialog>
            {
                { x => x.Previa, _previa },
                { x => x.Produtos, _produtos },
                { x => x.Categorias, _categorias },
                { x => x.Saidas, _saidas }
            };
            var dialog = await DialogService.ShowAsync<PreviaComprovanteDialog>(
                "Prévia do comprovante", parametros, OpcoesCompra());
            var resultado = await dialog.Result;
            if (_descartada)
                return;

            if (resultado is not { Canceled: false, Data: CompraCestaFormModel modelo })
            {
                if (_previa?.Linhas.Count == 0)
                    _previa = null;
                return;
            }

            await CarregarAsync();
            try
            {
                var comProduto = modelo.ItensSaida.Where(item => item is { ExigeConfirmacao: true }).ToList();
                if (comProduto.Count > 0)
                    CasamentoComprovante.GarantirConfirmacao(comProduto);
            }
            catch (InvalidOperationException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
                return;
            }

            if (await SalvarCompraAsync("Nova compra", modelo))
            {
                _previa = null;
                _comprovante = null;
                _saidas = [];
                _exibicao = null;
            }
        }
        finally
        {
            _previaAberta = false;
            if (!_descartada)
                StateHasChanged();
        }
    }

    private bool Cancelada(int geracao) =>
        _descartada || geracao != _geracao || _pagina.IsCancellationRequested;

    private async Task CarregarAsync()
    {
        _carregando = true;
        _categorias = (await CategoriaService.ListarAsync())
            .Where(c => c.TipoPadrao == TipoTransacao.Despesa && c.Nome != CestaDespesaRegras.NomeCategoria)
            .ToList();
        _produtos = await CestaService.ListarProdutosAsync();
        _locais = await CestaService.ListarLocaisAsync();
        _compras = await CestaService.ListarComprasAsync(_referencia.Month, _referencia.Year);
        _comparativo = await CestaService.CompararAsync(_referencia.Month, _referencia.Year);
        _carregando = false;
    }

    private async Task MudarMes(int delta)
    {
        _referencia = _referencia.AddMonths(delta);
        await CarregarAsync();
    }

