    private async Task TrazerMesAnteriorAsync()
    {
        if (!await GarantirCatalogoAsync())
            return;

        var rascunhos = await CestaService.ListarRascunhosAsync(_referencia.Month, _referencia.Year);
        if (rascunhos.Count == 0)
        {
            Snackbar.Add("Não há cesta do mês anterior para trazer.", Severity.Info);
            return;
        }

        foreach (var rascunho in rascunhos)
        {
            var local = _locais.FirstOrDefault(l => l.Id == rascunho.LocalCompraId)?.Nome ?? "local";
            var salvou = await SalvarCompraAsync($"Atualizar cesta — {local}", rascunho);
            if (!salvou)
                break;
        }
    }

