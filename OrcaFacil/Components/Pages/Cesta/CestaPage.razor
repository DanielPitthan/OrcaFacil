    private async Task ImportarProdutosAsync()
    {
        if (_categorias.Count == 0)
        {
            Snackbar.Add("Cadastre uma categoria de despesa antes de importar.", Severity.Warning);
            return;
        }

        FileResult? arquivo;
        try
        {
            arquivo = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Importar produtos da cesta",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.Android, new[] { "text/csv", "text/comma-separated-values", "text/plain", "application/vnd.ms-excel", "application/octet-stream" } },
                    { DevicePlatform.WinUI, new[] { ".csv", ".txt" } }
                })
            });
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível abrir o seletor de arquivos.", Severity.Error);
            return;
        }

        if (arquivo is null)
            return;

        _importando = true;
        try
        {
            await using var stream = await arquivo.OpenReadAsync();
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var leitura = ProdutoCestaCsv.Ler(ProdutoCestaCsv.Decodificar(memoria.ToArray()));
            if (leitura.Linhas.Count == 0)
            {
                Snackbar.Add(leitura.Erros.FirstOrDefault() ?? "O arquivo não tem produtos.", Severity.Warning);
                return;
            }

            int? categoriaPadrao = null;
            if (leitura.Linhas.Any(l => string.IsNullOrWhiteSpace(l.Categoria)))
            {
                var parametros = new DialogParameters<CategoriaImportacaoDialog>
                {
                    { x => x.Categorias, _categorias }
                };
                var dialog = await DialogService.ShowAsync<CategoriaImportacaoDialog>("Categoria dos produtos", parametros, Opcoes(MaxWidth.ExtraSmall));
                var resultado = await dialog.Result;
                if (resultado is not { Canceled: false, Data: int categoriaId })
                    return;

                categoriaPadrao = categoriaId;
            }

            var importacao = await CestaService.ImportarProdutosAsync(leitura.Linhas, _categorias, categoriaPadrao);
            var erros = leitura.Erros.Concat(importacao.Erros).ToList();
            var texto = $"{importacao.Importados} importado(s)";
            if (importacao.Ignorados > 0)
                texto += $", {importacao.Ignorados} já existente(s)";
            if (erros.Count > 0)
                texto += ". " + string.Join(" ", erros.Take(3));

            Snackbar.Add(texto, erros.Count > 0 ? Severity.Warning : Severity.Success);
            await CarregarAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importando = false;
        }
    }

