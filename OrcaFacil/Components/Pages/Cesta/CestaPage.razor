    private async Task<bool> SalvarCompraAsync(string titulo, CompraCestaFormModel modelo)
    {
        var locais = _locais.Where(l => l.Ativo || l.Id == modelo.LocalCompraId).ToList();
        var produtos = CompraCestaItens.FiltrarProdutos(_produtos, modelo);
        var parametros = new DialogParameters<CompraCestaDialog>
        {
            { x => x.Modelo, modelo },
            { x => x.Locais, locais },
            { x => x.Produtos, produtos }
        };
        var dialog = await DialogService.ShowAsync<CompraCestaDialog>(titulo, parametros, OpcoesCompra());
        var resultado = await dialog.Result;
        if (resultado is not { Canceled: false, Data: CompraCestaFormModel salvo })
            return false;

        try
        {
            await CestaService.SalvarCompraAsync(salvo);
            Snackbar.Add(modelo.Id is null ? "Compra registrada" : "Compra atualizada", Severity.Success);
            _aba = 0;
            await CarregarAsync();
            return true;
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return false;
        }
        catch (DbUpdateException ex) when (CestaCadastroService.NomeDeProdutoRepetido(ex))
        {
            Snackbar.Add(CestaCadastroService.MensagemNomeProdutoRepetido, Severity.Warning);
            return false;
        }
        catch (DbUpdateException)
        {
            Snackbar.Add(CestaCadastroService.MensagemFalhaAoGravar, Severity.Warning);
            return false;
        }
    }

