<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (!SomenteCategoria)
            {
                <MudTextField @ref="_nome" T="string" @bind-Value="_textoNome" Label="Produto"
                              Required="true" RequiredError="Informe o nome do produto." MaxLength="80"
                              Immediate="true" Class="mb-3" />
            }
            <MudSelect T="int" @bind-Value="Modelo.CategoriaId" Label="Categoria" Required="true"
                       RequiredError="Selecione a categoria do produto." Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var categoria in Categorias)
                {
                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Icone @categoria.Nome</MudSelectItem>
                }
            </MudSelect>
            @if (Modelo.Id is not null)
            {
                <MudCheckBox T="bool" @bind-Value="Modelo.Ativo" Label="Ativo" />
            }
            @if (!string.IsNullOrWhiteSpace(_erro))
            {
                <p class="of-previa-erro" role="alert">@_erro</p>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProdutoCestaFormModel Modelo { get; set; } = new();
    [Parameter] public IReadOnlyList<Categoria> Categorias { get; set; } = Array.Empty<Categoria>();

    /// <summary>Opcional. Quando verdadeiro, o diálogo só pede a categoria.</summary>
    [Parameter] public bool SomenteCategoria { get; set; }

    private MudForm _form = null!;
    private MudTextField<string> _nome = null!;
    private string? _textoNome;
    private string? _erro;

    protected override void OnInitialized()
    {
        _textoNome = Modelo.Nome;
    }

    private async Task SalvarAsync()
    {
        try
        {
            _erro = null;
            if (!SomenteCategoria)
                Modelo.Nome = ConfirmacaoCadastroProduto.NomeParaSalvar(Modelo.Nome, _textoNome);

            await _form.ValidateAsync();
            _erro = ConfirmacaoCadastroProduto.Validar(Modelo.Nome, Modelo.CategoriaId, SomenteCategoria);
            if (_erro is null && !SomenteCategoria && !_form.IsValid)
                _erro = ConfirmacaoCadastroProduto.MensagemFalha;
        }
        catch (Exception ex)
        {
            _erro = string.IsNullOrWhiteSpace(ex.Message)
                ? ConfirmacaoCadastroProduto.MensagemFalha
                : ex.Message;
        }

        if (_erro is not null)
        {
            if (!SomenteCategoria && _nome is not null)
                await _nome.FocusAsync();
            return;
        }

        MudDialog.Close(DialogResult.Ok(Modelo));
    }
}
