@using OrcaFacil.Core.Llm
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Gutters="false" TitleClass="of-cesta-titulo" ContentClass="of-cesta-conteudo" ActionsClass="of-cesta-acoes of-previa-acoes">
    <TitleContent>
        <div class="of-previa-cabeca">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Voltar" OnClick="Cancelar" />
            <div class="of-appbar-titulos">
                <span class="of-appbar-titulo">Prévia do comprovante</span>
                <span class="of-appbar-sub">@Previa.TextoLocal</span>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="of-previa">
            <div class="of-previa-miolo">
                <div class="of-previa-bloco">
                    <FormSection Titulo="Leitura">
                        <p class="of-previa-contagem @(Previa.NaoIdentificados > 0 ? "of-previa-erro" : "of-previa-apoio")">
                            @Previa.TextoNaoIdentificados
                        </p>
                        <p class="of-previa-apoio">@Previa.Data.ToString("dd/MM/yyyy") · @Previa.TextoLocal</p>
                        @if (!Previa.Legivel)
                        {
                            <p class="of-previa-apoio">@NormalizadorComprovante.AvisoLeituraIncerta</p>
                        }
                        @if (Previa.TotalDivergente && Previa.TotalCupom is decimal cupom)
                        {
                            <div class="of-previa-totais">
                                <span>Total do cupom @cupom.ToString("C")</span>
                                <span>Soma das linhas @Previa.SomaLinhas.ToString("C")</span>
                            </div>
                        }
                        <p class="of-previa-apoio">Pagamento, benefício e cartão ficam na compra.</p>
                    </FormSection>
                </div>

                <div class="of-previa-bloco">
                    <FormSection Titulo="Itens">
                        <button type="button" class="of-previa-marcar" @onclick="MarcarTodos"
                                aria-label="Marcar todos os itens não pendentes">Marcar todos</button>
                        <ItemList TItem="LinhaPreviaComprovante" Itens="@Previa.Linhas" Contagem="@Contagem"
                                  SomaFormatada="@Previa.SomaLinhas.ToString("C")"
                                  Titulo="Titulo" Subtitulo="Subtitulo" Valor="Valor" Icone="Icone"
                                  ChaveItem="Chave" EmErro="EmErro" MostrarAdicionar="@Previa.PodeCadastrarTudo"
                                  TextoAdicionar="Cadastrar tudo" OnAdicionar="CadastrarTudoAsync"
                                  TextoVazio="Nenhum item na leitura."
                                  ExigeMarcacao="ExigeMarcacao" Marcado="EstaMarcado" OnAlternarMarcacao="AlternarMarcacao"
                                  AriaMarcacao="AriaMarcacao" Marcador="Marcador" Destacado="Destacado"
                                  ConfirmadoVisual="ConfirmadoVisual" ComplementoAriaMenu="ComplementoAria"
                                  OnEditar="Editar" OnRemover="Remover" />
                        @if (_pares.TemParNaoConfirmado)
                        {
                            <div class="of-par-bloco">
                                <p class="of-par-secao">Confirme o produto de cada item.</p>
                                @for (var i = 0; i < _pares.Linhas.Count; i++)
                                {
                                    var indice = i;
                                    var par = _pares.Linhas[indice];
                                    if (par.AguardandoConfirmacao)
                                    {
                                        <div class="of-par@(par.DestacarRevisao ? " of-par-revisar" : null)">
                                            <p class="of-par-nome">@par.NomeExibido</p>
                                            @if (!string.IsNullOrEmpty(par.DescricaoLida))
                                            {
                                                <p class="of-par-lido">@par.DescricaoLida</p>
                                            }
                                            @if (par.TextoConfianca is not null)
                                            {
                                                <p class="of-par-confianca">@par.TextoConfianca</p>
                                            }
                                            @if (par.DestacarRevisao)
                                            {
                                                <p class="of-par-revisao">Revisar</p>
                                            }
                                            <div class="of-par-acoes">
                                                <button type="button" class="of-par-botao" @onclick="() => ConfirmarPar(indice)">Confirmar</button>
                                                <button type="button" class="of-par-botao" @onclick="() => AbrirTroca(indice)">Trocar</button>
                                                <button type="button" class="of-par-botao" @onclick="() => DesfazerPar(indice)">Desfazer</button>
                                            </div>
                                            @if (_troca == indice)
                                            {
                                                @if (!_catalogo.Any())
                                                {
                                                    <p class="of-par-lido">Nenhum produto cadastrado.</p>
                                                }
                                                else
                                                {
                                                    <div class="of-par-opcoes">
                                                        @foreach (var produto in _catalogo)
                                                        {
                                                            <button type="button" class="of-previa-opcao" @onclick="() => AplicarTroca(indice, produto)">
                                                                @produto.Nome
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </FormSection>
                </div>

                @if (Previa.MensagemBloqueio is not null)
                {
                    <p id="previa-motivo-bloqueio" class="of-previa-erro" role="alert">@Previa.MensagemBloqueio</p>
                }
                @if (_pares.MensagemBloqueio is not null)
                {
                    <p class="of-par-alerta of-previa-erro" role="alert">@_pares.MensagemBloqueio</p>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <StickyActionBar Contido="true" TextoCancelar="Cancelar" TextoPrimario="Confirmar"
                         OnCancelar="Cancelar" OnPrimario="Confirmar" TipoPrimario="ButtonType.Button"
                         PrimarioDesabilitado="@(!Previa.PodeConfirmar)"
                         AriaDescribedBy="@(Previa.MensagemBloqueio is null ? null : "previa-motivo-bloqueio")" />
    </DialogActions>
</MudDialog>

<ItemSheet TItem="LinhaPreviaComprovante" @bind-Aberto="_sheetAberto" Item="_editando" AcimaDeDialogo="true"
           Titulo="@(_editando?.Titulo ?? "Item")" RotuloValor="Preço"
           Valor="_preco" ValorChanged="AlterarPreco" Erro="@_erroItem"
           MostrarOutro="false" MostrarCancelar="true" TextoConfirmar="Salvar" TextoCancelar="Cancelar"
           OnConfirmar="ConfirmarSheet">
    @if (_editando?.PodeCadastrar == true)
    {
        <MudButton Class="of-cadastrar" Variant="Variant.Outlined" Color="Color.Default" OnClick="CadastrarAsync">Cadastrar</MudButton>
    }
    @if (_editando?.PodeDesfazerNovo == true)
    {
        <MudButton Class="of-cadastrar" Variant="Variant.Outlined" Color="Color.Default" OnClick="DesfazerNovo">Desfazer</MudButton>
    }
    @if (!Opcoes().Any())
    {
        <p class="of-previa-apoio">Nenhum produto cadastrado.</p>
    }
    else
    {
        <div class="of-previa-opcoes">
            @foreach (var produto in Opcoes())
            {
                <button type="button" class="of-previa-opcao @(_produtoId == produto.Id ? "of-previa-opcao-ativa" : null)"
                        @onclick="() => Escolher(produto.Id)">
                    @produto.Nome
                </button>
            }
        </div>
    }
</ItemSheet>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public PreviaComprovante Previa { get; set; } = null!;
    [Parameter] public IReadOnlyList<ProdutoCesta> Produtos { get; set; } = [];
    [Parameter] public IReadOnlyList<Categoria> Categorias { get; set; } = [];
    [Parameter] public IReadOnlyList<ItemSaidaComprovante> Saidas { get; set; } = [];

    private readonly List<ProdutoCesta> _catalogo = [];
    private readonly Dictionary<int, Guid> _linhaPorPar = new();
    private ConfirmacaoParProduto _pares = ConfirmacaoParProduto.Criar(
        Array.Empty<ConfirmacaoParProduto.Entrada>(),
        Array.Empty<ProdutoCesta>());
    private int? _troca;
    private LinhaPreviaComprovante? _editando;
    private bool _sheetAberto;
    private bool _confirmando;
    private bool _cadastrando;
    private bool _cadastrandoTudo;
    private int _produtoId;
    private decimal _preco;
    private string? _erroItem;

    private string Contagem => CompraCestaEditor.Contagem(Previa.Linhas.Count);

    protected override void OnInitialized()
    {
        _catalogo.AddRange(Produtos.Where(p => p.Ativo).OrderBy(p => p.Nome, StringComparer.CurrentCultureIgnoreCase));
        _pares = ConfirmacaoParProduto.Criar(
            Saidas.Select(saida => new ConfirmacaoParProduto.Entrada(
                saida.ProdutoId,
                saida.Confianca,
                saida.Pendente,
                saida.DescricaoLida)).ToList(),
            Produtos);
        var chaves = Previa.Linhas
            .Select(linha => new ConfirmacaoParProduto.LinhaPreviaChave(linha.Id, linha.DescricaoLida, linha.ProdutoCestaId))
            .ToList();
        var ligacao = ConfirmacaoParProduto.Ligar(_pares.Linhas, chaves);
        for (var i = 0; i < ligacao.Length; i++)
        {
            if (ligacao[i] is Guid id)
                _linhaPorPar[i] = id;
        }
    }

    private bool PodeGravarCompra => Previa.PodeConfirmar && _pares.PodeGravar;

    private void Cancelar()
    {
        Previa.CancelarCadastro();
        MudDialog.Cancel();
    }

    private void Confirmar()
    {
        if (!Previa.PodeConfirmar || _confirmando)
            return;

        try
        {
            Previa.ConfirmarMarcados();
            var comProduto = Previa.ItensComProduto();
            if (comProduto.Count > 0)
                CasamentoComprovante.GarantirConfirmacao(comProduto);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }

        _confirmando = true;
        MudDialog.Close(DialogResult.Ok(Previa.ParaCompra()));
    }

    private void Editar(LinhaPreviaComprovante linha)
    {
        _editando = linha;
        _produtoId = linha.ProdutoCestaId ?? 0;
        _preco = linha.Preco;
        _erroItem = null;
        if (_produtoId > 0 && _catalogo.All(p => p.Id != _produtoId))
        {
            var atual = Produtos.FirstOrDefault(p => p.Id == _produtoId);
            if (atual is not null)
                _catalogo.Add(atual);
        }

        _sheetAberto = true;
    }

    private void Remover(LinhaPreviaComprovante linha)
    {
        if (_editando == linha)
        {
            _editando = null;
            _sheetAberto = false;
        }

        Previa.Remover(linha);
    }

    private Task AlterarPreco(decimal valor)
    {
        _preco = valor;
        _erroItem = null;
        return Task.CompletedTask;
    }

    private void Escolher(int produtoId)
    {
        _produtoId = produtoId;
        _erroItem = null;
    }

    private void ConfirmarSheet(LinhaPreviaComprovante _)
    {
        if (_editando is null)
            return;

        if (_preco <= 0)
        {
            _erroItem = "Informe o preço do item.";
            return;
        }

        if (_editando.NovoSeraCriado && (_produtoId <= 0 || _produtoId == _editando.ProdutoCestaId))
        {
            Previa.AlterarPreco(_editando, _preco);
            _sheetAberto = false;
            return;
        }

        if (_produtoId <= 0)
        {
            _erroItem = "Selecione o produto.";
            return;
        }

        var produto = _catalogo.FirstOrDefault(p => p.Id == _produtoId);
        if (produto is null)
        {
            _erroItem = "Selecione o produto.";
            return;
        }

        if (_editando.ProdutoCestaId != produto.Id)
        {
            Previa.Classificar(_editando, produto);
            TrocarParesDaLinha(_editando, produto.Id);
        }

        Previa.AlterarPreco(_editando, _preco);
        Previa.Marcar(_editando);
        _sheetAberto = false;
    }

    private async Task CadastrarAsync()
    {
        if (_cadastrando || _cadastrandoTudo || _confirmando || _editando is null || !_editando.PodeCadastrar)
            return;

        _cadastrando = true;
        try
        {
            var linha = _editando;
            if (Categorias.Count == 0)
            {
                Snackbar.Add("Cadastre uma categoria de despesa antes do produto.", Severity.Info);
                return;
            }

            var modelo = Previa.IniciarCadastro(linha);
            if (modelo is null)
            {
                Snackbar.Add(ConfirmacaoCadastroProduto.MensagemFalha, Severity.Warning);
                return;
            }

            _sheetAberto = false;
            var parametros = new DialogParameters<ProdutoCestaDialog>
            {
                { x => x.Modelo, modelo },
                { x => x.Categorias, Categorias }
            };
            var dialog = await DialogService.ShowAsync<ProdutoCestaDialog>("Novo produto", parametros, OpcoesProduto());
            var resultado = await dialog.Result;
            if (resultado is not { Canceled: false, Data: ProdutoCestaFormModel salvo })
            {
                Previa.CancelarCadastro();
                _editando = linha;
                _sheetAberto = true;
                return;
            }

            var categoria = Categorias.FirstOrDefault(item => item.Id == salvo.CategoriaId)?.Nome;
            try
            {
                Previa.ConfirmarCadastro(salvo, _preco, categoria);
            }
            catch (Exception ex)
            {
                Previa.CancelarCadastro();
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(ex.Message) ? ConfirmacaoCadastroProduto.MensagemFalha : ex.Message,
                    Severity.Warning);
                _editando = linha;
                _sheetAberto = true;
                return;
            }

            _sheetAberto = false;
            _erroItem = null;
        }
        finally
        {
            _cadastrando = false;
        }
    }

    private async Task CadastrarTudoAsync()
    {
        if (_cadastrandoTudo || _cadastrando || _confirmando || !Previa.PodeCadastrarTudo)
            return;

        _cadastrandoTudo = true;
        try
        {
            if (Categorias.Count == 0)
            {
                Snackbar.Add("Cadastre uma categoria de despesa antes do produto.", Severity.Info);
                return;
            }

            var categoria = Categorias[0];
            if (Categorias.Count > 1)
            {
                var parametros = new DialogParameters<ProdutoCestaDialog>
                {
                    { x => x.Modelo, new ProdutoCestaFormModel { Ativo = true } },
                    { x => x.Categorias, Categorias },
                    { x => x.SomenteCategoria, true }
                };
                var dialog = await DialogService.ShowAsync<ProdutoCestaDialog>("Categoria dos novos", parametros, OpcoesProduto());
                var resultado = await dialog.Result;
                if (resultado is not { Canceled: false, Data: ProdutoCestaFormModel salvo })
                    return;

                var escolhida = Categorias.FirstOrDefault(item => item.Id == salvo.CategoriaId);
                if (escolhida is null)
                    return;

                categoria = escolhida;
            }

            Previa.CadastrarTudo(categoria.Id, categoria.Nome);
        }
        finally
        {
            _cadastrandoTudo = false;
        }
    }

    private void ConfirmarPar(int indice)
    {
        var par = _pares.Linhas[indice];
        var linha = LinhaLigada(indice);
        var produto = par.ProdutoId is int id ? Produto(id) : null;
        _pares.Confirmar(indice);
        if (linha is not null && produto is not null)
            Previa.Classificar(linha, produto);

        if (_troca == indice)
            _troca = null;
    }

    private void AbrirTroca(int indice) => _troca = _troca == indice ? null : indice;

    private void AplicarTroca(int indice, ProdutoCesta produto)
    {
        if (!_pares.Trocar(indice, produto.Id))
            return;

        var linha = LinhaLigada(indice);
        if (linha is not null)
            Previa.Classificar(linha, produto);

        _troca = null;
    }

    private void DesfazerPar(int indice)
    {
        _pares.Desfazer(indice);
        if (_linhaPorPar.TryGetValue(indice, out var linhaId) && LinhaLiberada(linhaId))
        {
            var linha = Previa.Linhas.FirstOrDefault(item => item.Id == linhaId);
            if (linha is not null)
            {
                if (_editando == linha)
                {
                    _editando = null;
                    _sheetAberto = false;
                }

                ConfirmacaoParProduto.AplicarNaoIdentificado(linha);
            }
        }

        if (_troca == indice)
            _troca = null;
    }

    private void TrocarParesDaLinha(LinhaPreviaComprovante linha, int produtoId)
    {
        foreach (var par in _linhaPorPar)
        {
            if (par.Value != linha.Id)
                continue;

            _pares.Trocar(par.Key, produtoId);
        }
    }

    private LinhaPreviaComprovante? LinhaLigada(int indice) =>
        _linhaPorPar.TryGetValue(indice, out var linhaId)
            ? Previa.Linhas.FirstOrDefault(item => item.Id == linhaId)
            : null;

    private bool LinhaLiberada(Guid linhaId)
    {
        var alguma = false;
        foreach (var par in _linhaPorPar)
        {
            if (par.Value != linhaId)
                continue;

            alguma = true;
            if (!_pares.Linhas[par.Key].NaoIdentificado)
                return false;
        }

        return alguma;
    }

    private ProdutoCesta? Produto(int id) =>
        _catalogo.FirstOrDefault(produto => produto.Id == id)
        ?? Produtos.FirstOrDefault(produto => produto.Id == id);

    private void DesfazerNovo()
    {
        if (_editando is null)
            return;

        Previa.DesfazerNovo(_editando);
        _sheetAberto = false;
        _erroItem = null;
    }

    private IEnumerable<ProdutoCesta> Opcoes()
    {
        if (_editando?.Ambiguo == true && _editando.CandidatosIds.Count > 0)
            return _catalogo.Where(produto => _editando.CandidatosIds.Contains(produto.Id));

        return _catalogo;
    }

    private static string Titulo(LinhaPreviaComprovante linha) => linha.Titulo;

    private void MarcarTodos() => Previa.MarcarNaoPendentes();

    private static bool ExigeMarcacao(LinhaPreviaComprovante linha) => linha.ProdutoCestaId is > 0;

    private static bool EstaMarcado(LinhaPreviaComprovante linha) => linha.Marcado;

    private void AlternarMarcacao(LinhaPreviaComprovante linha)
    {
        Previa.AlternarMarcacao(linha);
    }

    private static string AriaMarcacao(LinhaPreviaComprovante linha)
    {
        var acao = linha.Marcado ? "Desmarcar" : "Marcar";
        return linha.Pendente ? $"{acao} {linha.Nome}, pendente" : $"{acao} {linha.Nome}";
    }

    private static string? Marcador(LinhaPreviaComprovante linha) => linha.MarcadorCasamento;

    private static bool Destacado(LinhaPreviaComprovante linha) =>
        linha.ProdutoCestaId is > 0 && linha.Pendente && !linha.Marcado && !linha.CasamentoConfirmado;

    private static bool ConfirmadoVisual(LinhaPreviaComprovante linha) =>
        linha.ProdutoCestaId is > 0 && (linha.Marcado || linha.CasamentoConfirmado);

    private static string? ComplementoAria(LinhaPreviaComprovante linha)
    {
        if (linha.ProdutoCestaId is not > 0)
            return null;

        if (linha.Marcado || linha.CasamentoConfirmado)
            return linha.Pendente ? "pendente, confirmado" : "confirmado";

        return linha.Pendente ? "pendente, não confirmado" : "não confirmado";
    }

    private static string Subtitulo(LinhaPreviaComprovante linha) => linha.Subtitulo;

    private static string Valor(LinhaPreviaComprovante linha) => linha.Preco.ToString("C");

    private static string Icone(LinhaPreviaComprovante linha) => linha.NaoIdentificado ? "❓" : "🛒";

    private static bool EmErro(LinhaPreviaComprovante linha) => linha.NaoIdentificado;

    private static object Chave(LinhaPreviaComprovante linha) => linha.Id;

    private static DialogOptions OpcoesProduto() => new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
}
