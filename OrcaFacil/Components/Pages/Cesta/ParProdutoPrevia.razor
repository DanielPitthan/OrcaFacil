@using OrcaFacil.Core.Llm

@if (Previa.Linhas.Any(ConfirmacaoParProduto.PodeAjustar))
{
    <div class="of-par-bloco">
        <p class="of-par-secao">Trocar ou desfazer o produto.</p>
        @foreach (var linha in Previa.Linhas)
        {
            if (!ConfirmacaoParProduto.PodeAjustar(linha))
                continue;

            var atual = linha;
            <ItemParPrevia Linha="atual" Catalogo="Catalogo"
                           OnTrocar="produto => Trocar(atual, produto)"
                           OnDesfazer="() => Desfazer(atual)" />
        }
    </div>
}

@code {
    [Parameter] public PreviaComprovante Previa { get; set; } = null!;
    [Parameter] public IReadOnlyList<ProdutoCesta> Catalogo { get; set; } = [];
    [Parameter] public EventCallback<LinhaPreviaComprovante> OnLinhaDesfeita { get; set; }

    private void Trocar(LinhaPreviaComprovante linha, ProdutoCesta produto) =>
        ConfirmacaoParProduto.Trocar(Previa, linha, produto, Catalogo);

    private void Desfazer(LinhaPreviaComprovante linha)
    {
        ConfirmacaoParProduto.Desfazer(linha);
        _ = OnLinhaDesfeita.InvokeAsync(linha);
    }
}
