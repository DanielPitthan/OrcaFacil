@inject ICartaoService CartaoService

<MudDialog Gutters="false" TitleClass="of-cesta-titulo" ContentClass="of-cesta-conteudo" ActionsClass="of-cesta-acoes">
    <TitleContent>
        <div class="of-cesta-cabeca">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Voltar" OnClick="Cancelar" />
            <div class="of-appbar-titulos">
                <span class="of-appbar-titulo">Cesta básica</span>
                <span class="of-appbar-sub">@Subtitulo</span>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="of-cesta">
            <div class="of-cesta-miolo">
                <div class="of-cesta-bloco">
                    <SummaryCard Rotulo="Total da cesta" Valor="@Total" Contexto="@Contexto"
                                 Status="@RotuloStatus" TomStatus="@TomStatus"
                                 Progresso="@Percentual" ProgressoCritico="@BeneficioEstoura"
                                 RotuloProgresso="Aproveitamento do benefício" Legendas="@Legendas" />
                </div>

                <div class="of-cesta-bloco">
                    <FormSection Titulo="Compra">
                        @if (Locais.Count == 0)
                        {
                            <div class="of-secao-bloco">
                                <MudAlert Severity="Severity.Info" Dense="true">Cadastre um local de compra antes de registrar a cesta.</MudAlert>
                            </div>
                        }
                        else
                        {
                            <div class="of-seletor">
                                <MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter"
                                         TransformOrigin="Origin.TopCenter" MaxHeight="320">
                                    <ActivatorContent>
                                        <FormRow Icone="@Icons.Material.Outlined.Store" Rotulo="Local de compra"
                                                 Valor="@LocalAtual?.Nome" Chevron="true" Embutido="true"
                                                 AriaLabel="Selecionar local de compra" />
                                    </ActivatorContent>
                                    <ChildContent>
                                        @foreach (var local in Locais)
                                        {
                                            <MudMenuItem OnClick="@(() => SelecionarLocal(local))">@local.Nome</MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        }
                        <FormRow Icone="@Icons.Material.Outlined.Event" Rotulo="Data">
                            <MudDatePicker Date="_data" DateChanged="AlterarData" Variant="Variant.Text" Margin="Margin.Dense" />
                        </FormRow>
                    </FormSection>
                </div>

                <div class="of-cesta-bloco">
                    <FormSection Titulo="Itens">
                        <ItemList TItem="ItemCompraCestaFormModel" Itens="@_linhas" Contagem="@Contagem" SomaFormatada="@Total.ToString("C")"
                                  Titulo="TituloItem" Subtitulo="SubtituloItem" Valor="ValorItem" Icone="IconeItem" Cor="CorItem"
                                  ChaveItem="ChaveItem" TextoVazio="Nenhum item ainda. Inclua um por vez, como no caixa."
                                  OnEditar="EditarItem" OnRemover="RemoverItem" OnAdicionar="AbrirNovo" />
                    </FormSection>
                </div>

                <div class="of-cesta-bloco">
                    <FormSection Titulo="Pagamento">
                        <div class="of-secao-bloco">
                            <MudSwitch T="bool" Value="_usarBeneficio" ValueChanged="AlterarBeneficio" Color="Color.Success" Label="Usar cartão de benefício" />
                            <p class="of-cesta-apoio">@CompraCestaEditor.TextoApoioBeneficio(_usarBeneficio)</p>
                        </div>

                        @if (_usarBeneficio)
                        {
                            @if (_cartoesBeneficio.Count == 0)
                            {
                                <div class="of-secao-bloco">
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        Cadastre um cartão de benefício em Cartões antes de usar este desconto.
                                    </MudAlert>
                                </div>
                            }
                            else
                            {
                                <div class="of-seletor">
                                    <MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter"
                                             TransformOrigin="Origin.TopCenter" MaxHeight="320">
                                        <ActivatorContent>
                                            <FormRow Icone="@Icons.Material.Outlined.CardGiftcard" Rotulo="Cartão de benefício"
                                                     Valor="@RotuloCartaoBeneficio" Chevron="true" Embutido="true"
                                                     AriaLabel="Selecionar cartão de benefício" />
                                        </ActivatorContent>
                                        <ChildContent>
                                            @foreach (var cartao in _cartoesBeneficio)
                                            {
                                                <MudMenuItem OnClick="@(() => OnCartaoBeneficioChangedAsync(cartao.Id))">
                                                    @cartao.Rotulo (@(cartao.TipoBeneficio?.Rotulo() ?? "Benefício"))
                                                </MudMenuItem>
                                            }
                                        </ChildContent>
                                    </MudMenu>
                                </div>
                                <div class="of-secao-bloco">
                                    <p class="of-cesta-dica @(SaldoBeneficioSelecionado < BeneficioInformado ? "of-cesta-dica-critica" : null)">
                                        Saldo disponível: <b class="of-moeda">@SaldoBeneficioSelecionado.ToString("C")</b>
                                    </p>
                                </div>
                            }
                            <FormRow Icone="@Icons.Material.Outlined.Payments" Rotulo="Valor usado do benefício">
                                <CampoNumerico TNumber="decimal" Value="_beneficio" ValueChanged="AlterarValorBeneficio"
                                               Adornment="Adornment.Start" AdornmentText="R$" />
                            </FormRow>
                        }

                        @if (BeneficioCobre)
                        {
                            <div class="of-secao-bloco">
                                <MudAlert Severity="Severity.Success" Dense="true">O benefício cobre a compra. Nada a pagar do bolso.</MudAlert>
                            </div>
                        }
                        else if (Saldo > 0)
                        {
                            <div class="of-secao-bloco">
                                <p class="of-cesta-apoio">Saldo de <span class="of-moeda">@Saldo.ToString("C")</span></p>
                                <SegmentedControl T="ModoPagamentoCesta" Valor="_modo" ValorChanged="AlterarModo"
                                                  Opcoes="@Modos" AriaLabel="Forma do saldo" Vertical="true" />
                            </div>
                            @if (_modo == ModoPagamentoCesta.Dividido)
                            {
                                <FormRow Icone="@Icons.Material.Outlined.Payments" Rotulo="Quanto em dinheiro">
                                    <CampoNumerico TNumber="decimal" Value="_dinheiroInformado" ValueChanged="AlterarDinheiro"
                                                   Adornment="Adornment.Start" AdornmentText="R$" />
                                </FormRow>
                                <div class="of-secao-bloco">
                                    <p class="of-cesta-dica @(CartaoEfetivo < 0 ? "of-cesta-dica-critica" : null)">
                                        Restante no cartão de crédito: <span class="of-moeda">@Math.Max(0, CartaoEfetivo).ToString("C")</span>
                                    </p>
                                </div>
                            }

                            @if (CartaoEfetivo > 0)
                            {
                                @if (_cartoesCredito.Count == 0)
                                {
                                    <div class="of-secao-bloco">
                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                            Cadastre um cartão de crédito em Cartões para registrar o pagamento no crédito.
                                        </MudAlert>
                                    </div>
                                }
                                else
                                {
                                    <div class="of-seletor">
                                        <MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter"
                                                 TransformOrigin="Origin.TopCenter" MaxHeight="320">
                                            <ActivatorContent>
                                                <FormRow Icone="@Icons.Material.Outlined.CreditCard" Rotulo="Cartão de crédito"
                                                         Valor="@CartaoCreditoAtual?.Rotulo" Chevron="true" Embutido="true"
                                                         AriaLabel="Selecionar cartão de crédito" />
                                            </ActivatorContent>
                                            <ChildContent>
                                                @foreach (var cartao in _cartoesCredito)
                                                {
                                                    <MudMenuItem OnClick="@(() => OnCartaoCreditoChangedAsync(cartao.Id))">@cartao.Rotulo</MudMenuItem>
                                                }
                                            </ChildContent>
                                        </MudMenu>
                                    </div>

                                    @if (_faturasAbertas.Count == 0)
                                    {
                                        <div class="of-secao-bloco">
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                Nenhuma fatura em aberto para este cartão. Uma nova fatura será criada nos lançamentos.
                                            </MudAlert>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="of-seletor">
                                            <MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter"
                                                     TransformOrigin="Origin.TopCenter" MaxHeight="320">
                                                <ActivatorContent>
                                                    <FormRow Icone="@Icons.Material.Outlined.Receipt" Rotulo="Lançamento da fatura"
                                                             Valor="@RotuloFatura" Chevron="true" Embutido="true"
                                                             AriaLabel="Selecionar lançamento da fatura" />
                                                </ActivatorContent>
                                                <ChildContent>
                                                    <MudMenuItem OnClick="@(() => _faturaTransacaoId = null)">Criar nova fatura</MudMenuItem>
                                                    @foreach (var fatura in _faturasAbertas)
                                                    {
                                                        <MudMenuItem OnClick="@(() => _faturaTransacaoId = fatura.Id)">
                                                            @fatura.Descricao — @fatura.Data.ToString("dd/MM/yyyy") (@fatura.Valor.ToString("C"))
                                                        </MudMenuItem>
                                                    }
                                                </ChildContent>
                                            </MudMenu>
                                        </div>
                                    }
                                }
                            }
                        }
                    </FormSection>
                </div>

                @if (_erro is not null)
                {
                    <p class="of-cesta-erro" role="alert">@_erro</p>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <StickyActionBar Contido="true" TextoCancelar="Cancelar" TextoPrimario="Salvar compra"
                         OnCancelar="Cancelar" OnPrimario="Salvar" TipoPrimario="ButtonType.Button" />
    </DialogActions>
</MudDialog>

<ItemSheet TItem="ItemCompraCestaFormModel" @ref="_sheet" @bind-Aberto="_sheetAberto" Item="_editando" AcimaDeDialogo="true"
           Titulo="@(_editando is null ? "Adicionar item" : "Editar item")" RotuloValor="Preço"
           Valor="_precoItem" ValorChanged="AlterarPreco" Dica="@DicaItem" Erro="@_erroItem"
           MostrarOutro="@(_editando is null)" TextoConfirmar="@(_editando is null ? "Adicionar" : "Salvar")"
           TextoOutro="Adicionar outro" OnConfirmar="ConfirmarAsync" OnConfirmarOutro="ConfirmarOutroAsync">
    @if (!Produtos.Any(p => p.Id > 0))
    {
        <p class="of-cesta-apoio">Não há produto cadastrado para a cesta.</p>
    }
    else if (_listaCompleta)
    {
        <div class="of-cesta-cats">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="FecharLista">Principais</MudButton>
            <MudList T="ProdutoCesta" Dense="true">
                @foreach (var produto in Produtos.Where(p => p.Id > 0))
                {
                    <MudListItem T="ProdutoCesta" OnClick="@(() => EscolherProduto(produto.Id))">
                        <span class="of-cesta-opcao">@produto.Nome</span>
                    </MudListItem>
                }
            </MudList>
        </div>
    }
    else
    {
        <div class="of-cesta-cats">
            <MudChipSet T="int" SelectedValue="_produtoId" SelectedValueChanged="EscolherProduto"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
                @foreach (var produto in ProdutosVisiveis)
                {
                    <MudChip T="int" Value="@produto.Id" Variant="Variant.Outlined" Color="Color.Primary" Text="@produto.Nome" />
                }
            </MudChipSet>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Class="of-cesta-todas" OnClick="AbrirLista">Todas…</MudButton>
        </div>
    }
</ItemSheet>

@code {
    private static readonly IReadOnlyList<OpcaoSegmento<ModoPagamentoCesta>> Modos =
    [
        new(ModoPagamentoCesta.Dinheiro, "Dinheiro"),
        new(ModoPagamentoCesta.Cartao, "Cartão de crédito"),
        new(ModoPagamentoCesta.Dividido, "Dividir")
    ];

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CompraCestaFormModel Modelo { get; set; } = new();
    [Parameter] public IReadOnlyList<LocalCompra> Locais { get; set; } = Array.Empty<LocalCompra>();
    [Parameter] public IReadOnlyList<ProdutoCesta> Produtos { get; set; } = Array.Empty<ProdutoCesta>();

    private readonly List<ItemCompraCestaFormModel> _linhas = new();
    private List<Cartao> _cartoesBeneficio = new();
    private List<Cartao> _cartoesCredito = new();
    private List<Transacao> _faturasAbertas = new();
    private readonly Dictionary<int, decimal> _saldosBeneficio = new();

    private ItemSheet<ItemCompraCestaFormModel>? _sheet;
    private bool _sheetAberto;
    private bool _listaCompleta;
    private ItemCompraCestaFormModel? _editando;
    private int _localId;
    private int _produtoId;
    private decimal _precoItem;
    private DateTime? _data;
    private bool _usarBeneficio;
    private decimal _beneficio;
    private int _cartaoBeneficioId;
    private decimal _dinheiroInformado;
    private int _cartaoCreditoId;
    private int? _faturaTransacaoId;
    private ModoPagamentoCesta _modo = ModoPagamentoCesta.Dinheiro;
    private string? _erro;
    private string? _erroItem;

    private decimal Total => _linhas.Sum(l => l.Preco);
    private decimal BeneficioInformado => _usarBeneficio ? _beneficio : 0;
    private decimal Saldo => CompraCestaEditor.Saldo(Total, BeneficioInformado);
    private (decimal Dinheiro, decimal Cartao) Partes => CompraCestaEditor.Pagamento(_modo, Saldo, _dinheiroInformado);
    private decimal DinheiroEfetivo => Partes.Dinheiro;
    private decimal CartaoEfetivo => Partes.Cartao;
    private decimal Aproveitamento => CompraCestaEditor.Aproveitamento(Total, BeneficioInformado);
    private decimal SaldoBeneficioSelecionado => _saldosBeneficio.GetValueOrDefault(_cartaoBeneficioId);
    private bool BeneficioCobre => Saldo <= 0 && Total > 0 && BeneficioInformado >= Total;
    private bool BeneficioEstoura => _usarBeneficio && CestaDespesaRegras.Dinheiro(_beneficio) > CestaDespesaRegras.Dinheiro(Total);

    private LocalCompra? LocalAtual => Locais.FirstOrDefault(l => l.Id == _localId);
    private Cartao? CartaoBeneficioAtual => _cartoesBeneficio.FirstOrDefault(c => c.Id == _cartaoBeneficioId);
    private Cartao? CartaoCreditoAtual => _cartoesCredito.FirstOrDefault(c => c.Id == _cartaoCreditoId);
    private string Subtitulo => LocalAtual?.Nome ?? "Sem local";
    private string Contagem => CompraCestaEditor.Contagem(_linhas.Count);
    private string Contexto
    {
        get
        {
            var data = (_data ?? DateTime.Today).ToString("dd/MM/yyyy");
            return BeneficioInformado > 0 && Total > 0
                ? $"{data} · Aproveitamento {Aproveitamento.ToString("0.##")}%"
                : data;
        }
    }

    private string RotuloCartaoBeneficio => CartaoBeneficioAtual is null
        ? ""
        : $"{CartaoBeneficioAtual.Rotulo} ({CartaoBeneficioAtual.TipoBeneficio?.Rotulo() ?? "Benefício"})";

    private string RotuloBeneficioSelecionado => CartaoBeneficioAtual?.Rotulo
        ?? (Modelo.TipoCartaoBeneficio ?? TipoCartaoBeneficio.ValeAlimentacao).Rotulo();

    private string RotuloCreditoSelecionado => CartaoCreditoAtual?.Rotulo ?? "Cartão de crédito";

    private string RotuloFatura
    {
        get
        {
            if (_faturaTransacaoId is not int id)
                return "Criar nova fatura";

            var fatura = _faturasAbertas.FirstOrDefault(f => f.Id == id);
            return fatura is null
                ? "Criar nova fatura"
                : $"{fatura.Descricao} — {fatura.Data:dd/MM/yyyy}";
        }
    }

    private SituacaoCompraCesta? SituacaoAtual => CompraCestaEditor.Situacao(Total, BeneficioInformado, Saldo);
    private string? RotuloStatus => SituacaoAtual is { } situacao ? CompraCestaEditor.RotuloSituacao(situacao) : null;
    private TomResumo TomStatus => SituacaoAtual == SituacaoCompraCesta.Coberta ? TomResumo.Sucesso : TomResumo.Alerta;
    private double Percentual => CompraCestaEditor.PercentualBeneficio(Total, BeneficioInformado);

    private IReadOnlyList<LegendaResumo> Legendas
    {
        get
        {
            var itens = new List<LegendaResumo>
            {
                new("A pagar", Saldo.ToString("C"), TomResumo.Alerta)
            };
            if (BeneficioInformado > 0)
                itens.Insert(0, new(RotuloBeneficioSelecionado, BeneficioInformado.ToString("C"), TomResumo.Sucesso));
            if (DinheiroEfetivo > 0 && CartaoEfetivo > 0)
            {
                itens.Add(new("Dinheiro", DinheiroEfetivo.ToString("C"), TomResumo.Primario));
                itens.Add(new(RotuloCreditoSelecionado, CartaoEfetivo.ToString("C"), TomResumo.Neutro));
            }
            return itens;
        }
    }

    private IReadOnlyList<ProdutoCesta> ProdutosVisiveis =>
        CompraCestaEditor.EmDestaque(Produtos.Where(p => p.Id > 0).ToList(), p => p.Id == _produtoId);

    private string? DicaItem =>
        _editando is null && _produtoId > 0 && _linhas.Any(l => l.ProdutoCestaId == _produtoId && string.IsNullOrEmpty(l.ProdutoNovoChave))
            ? "Este produto já está na compra. O preço será atualizado."
            : null;

    protected override async Task OnInitializedAsync()
    {
        _localId = Modelo.LocalCompraId > 0 ? Modelo.LocalCompraId : Locais.FirstOrDefault()?.Id ?? 0;
        _produtoId = Produtos.FirstOrDefault(p => p.Id > 0)?.Id ?? 0;
        _data = Modelo.Data == default ? DateTime.Today : Modelo.Data;
        _usarBeneficio = Modelo.ValorBeneficio > 0;
        _beneficio = Modelo.ValorBeneficio;
        _linhas.AddRange(CompraCestaItens.CopiarItens(Modelo));
        _modo = CompraCestaEditor.DefinirModo(Modelo.ValorDinheiro, Modelo.ValorCartaoCredito);
        _dinheiroInformado = Modelo.ValorDinheiro;

        var todosCartoes = await CartaoService.ListarAsync();
        _cartoesBeneficio = todosCartoes
            .Where(c => c.Tipo == TipoCartao.Beneficio && (c.Ativo || c.Id == Modelo.CartaoBeneficioId))
            .ToList();
        _cartoesCredito = todosCartoes
            .Where(c => c.Tipo == TipoCartao.Credito && (c.Ativo || c.Id == Modelo.CartaoCreditoId))
            .ToList();

        foreach (var cartao in _cartoesBeneficio)
            _saldosBeneficio[cartao.Id] = await CartaoService.ObterSaldoBeneficioAsync(cartao.Id, Modelo.Id);

        _cartaoBeneficioId = Modelo.CartaoBeneficioId is int cbId && _cartoesBeneficio.Any(c => c.Id == cbId)
            ? cbId
            : _cartoesBeneficio.FirstOrDefault()?.Id ?? 0;

        _cartaoCreditoId = Modelo.CartaoCreditoId is int ccId && _cartoesCredito.Any(c => c.Id == ccId)
            ? ccId
            : _cartoesCredito.FirstOrDefault()?.Id ?? 0;

        _faturaTransacaoId = Modelo.FaturaTransacaoId;
        if (_cartaoCreditoId > 0)
            await CarregarFaturasAsync(_cartaoCreditoId, preservarSelecionada: true);
    }

    private void Cancelar() => MudDialog.Cancel();

    private void SelecionarLocal(LocalCompra local)
    {
        _localId = local.Id;
        _erro = null;
    }

    private void AlterarData(DateTime? data)
    {
        _data = data;
        _erro = null;
    }

    private void AlterarBeneficio(bool usar)
    {
        _usarBeneficio = usar;
        _erro = null;
    }

    private Task AlterarValorBeneficio(decimal valor)
    {
        _beneficio = valor;
        _erro = null;
        return Task.CompletedTask;
    }

    private Task AlterarDinheiro(decimal valor)
    {
        _dinheiroInformado = valor;
        _erro = null;
        return Task.CompletedTask;
    }

    private Task AlterarPreco(decimal valor)
    {
        _precoItem = valor;
        _erroItem = null;
        return Task.CompletedTask;
    }

    private Task OnCartaoBeneficioChangedAsync(int cartaoId)
    {
        _cartaoBeneficioId = cartaoId;
        _erro = null;
        return Task.CompletedTask;
    }

    private async Task OnCartaoCreditoChangedAsync(int cartaoId)
    {
        _cartaoCreditoId = cartaoId;
        _erro = null;
        await CarregarFaturasAsync(cartaoId, preservarSelecionada: false);
    }

    private async Task CarregarFaturasAsync(int cartaoId, bool preservarSelecionada)
    {
        _faturasAbertas = cartaoId > 0
            ? await CartaoService.ListarFaturasAbertasAsync(cartaoId)
            : new List<Transacao>();

        if (preservarSelecionada && _faturaTransacaoId is int idAtual && _faturasAbertas.Any(f => f.Id == idAtual))
            return;

        _faturaTransacaoId = _faturasAbertas.FirstOrDefault(f => f.CartaoId == cartaoId)?.Id
            ?? _faturasAbertas.FirstOrDefault()?.Id;
    }

    private void AlterarModo(ModoPagamentoCesta modo)
    {
        _modo = modo;
        if (modo == ModoPagamentoCesta.Dividido && _dinheiroInformado <= 0)
            _dinheiroInformado = 0;
        _erro = null;
    }

    private void AbrirNovo()
    {
        _editando = null;
        _precoItem = 0;
        _erroItem = null;
        _listaCompleta = false;
        GarantirProduto();
        _sheetAberto = true;
    }

    private void EditarItem(ItemCompraCestaFormModel item)
    {
        _editando = item;
        _produtoId = item.ProdutoCestaId;
        _precoItem = item.Preco;
        _erroItem = null;
        _listaCompleta = false;
        _sheetAberto = true;
    }

    private void RemoverItem(ItemCompraCestaFormModel item)
    {
        if (_editando == item)
        {
            _editando = null;
            _sheetAberto = false;
        }

        _linhas.Remove(item);
        _erro = null;
    }

    private void GarantirProduto()
    {
        if (!Produtos.Any(p => p.Id > 0 && p.Id == _produtoId))
            _produtoId = Produtos.FirstOrDefault(p => p.Id > 0)?.Id ?? 0;
    }

    private void EscolherProduto(int produtoId)
    {
        if (produtoId <= 0)
            return;

        _produtoId = produtoId;
        _listaCompleta = false;
        _erroItem = null;
    }

    private void AbrirLista() => _listaCompleta = true;

    private void FecharLista() => _listaCompleta = false;

    private Task ConfirmarAsync(ItemCompraCestaFormModel _)
    {
        if (!AplicarRascunho())
            return Task.CompletedTask;

        _sheetAberto = false;
        return Task.CompletedTask;
    }

    private async Task ConfirmarOutroAsync(ItemCompraCestaFormModel _)
    {
        if (!AplicarRascunho())
            return;

        _precoItem = 0;
        _erroItem = null;
        if (_sheet is not null)
            await _sheet.FocarValorAsync();
    }

    private bool AplicarRascunho()
    {
        var erro = CompraCestaEditor.ValidarItem(_produtoId, _precoItem);
        if (erro is not null)
        {
            _erroItem = erro;
            return false;
        }

        if (_editando is null)
            CompraCestaEditor.AcrescentarOuAtualizar(_linhas, _produtoId, _precoItem);
        else
            CompraCestaEditor.AplicarEdicao(_linhas, _editando, _produtoId, _precoItem);

        _erroItem = null;
        _erro = null;
        return true;
    }

    private void Salvar()
    {
        _erro = CompraCestaEditor.Validar(
            _localId,
            _data,
            _linhas,
            _usarBeneficio,
            _cartaoBeneficioId,
            _beneficio,
            SaldoBeneficioSelecionado,
            DinheiroEfetivo,
            CartaoEfetivo,
            Saldo,
            Total,
            _cartaoCreditoId);
        if (_erro is not null)
            return;

        Modelo.LocalCompraId = _localId;
        Modelo.Data = _data!.Value.Date;
        Modelo.ValorBeneficio = _usarBeneficio ? _beneficio : 0;
        Modelo.CartaoBeneficioId = _usarBeneficio ? _cartaoBeneficioId : null;
        Modelo.TipoCartaoBeneficio = _usarBeneficio
            ? CartaoBeneficioAtual?.TipoBeneficio ?? Modelo.TipoCartaoBeneficio ?? TipoCartaoBeneficio.ValeAlimentacao
            : null;
        Modelo.ValorDinheiro = DinheiroEfetivo;
        Modelo.ValorCartaoCredito = CartaoEfetivo;
        Modelo.CartaoCreditoId = CartaoEfetivo > 0 ? _cartaoCreditoId : null;
        Modelo.FaturaTransacaoId = CartaoEfetivo > 0 ? _faturaTransacaoId : null;
        Modelo.Itens = CompraCestaItens.CopiarItens(new CompraCestaFormModel
        {
            Itens = _linhas,
            ProdutosNovos = Modelo.ProdutosNovos
        });
        MudDialog.Close(DialogResult.Ok(Modelo));
    }

    private string TituloItem(ItemCompraCestaFormModel item)
        => CompraCestaItens.Titulo(item, Produtos);

    private string SubtituloItem(ItemCompraCestaFormModel item)
        => CompraCestaEditor.Subtitulo(
            !string.IsNullOrEmpty(item.ProdutoNovoChave)
                ? item.CategoriaPendente
                : Produtos.FirstOrDefault(p => p.Id > 0 && p.Id == item.ProdutoCestaId)?.Categoria?.Nome);

    private string ValorItem(ItemCompraCestaFormModel item) => item.Preco.ToString("C");

    private string IconeItem(ItemCompraCestaFormModel item)
        => Produtos.FirstOrDefault(p => p.Id > 0 && p.Id == item.ProdutoCestaId)?.Categoria?.Icone ?? "🏷️";

    private string? CorItem(ItemCompraCestaFormModel item)
        => Produtos.FirstOrDefault(p => p.Id > 0 && p.Id == item.ProdutoCestaId)?.Categoria?.CorHex;

    private static object ChaveItem(ItemCompraCestaFormModel item) => item;
}
