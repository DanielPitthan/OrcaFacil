@using OrcaFacil.Core.Ativos
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSelect @ref="_ativo" T="int" @bind-Value="Modelo.AtivoId" Label="Ativo" Required="true"
                       RequiredError="Selecione um ativo" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var ativo in Ativos)
                {
                    <MudSelectItem T="int" Value="ativo.Id">@ativo.Ticker — @ativo.Nome</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="TipoOperacao" @bind-Value="Modelo.Tipo" Label="Tipo" Class="mb-3">
                <MudSelectItem Value="TipoOperacao.Compra">Compra</MudSelectItem>
                <MudSelectItem Value="TipoOperacao.Venda">Venda</MudSelectItem>
            </MudSelect>

            <MudDatePicker @ref="_data" Label="Data" @bind-Date="_dataOperacao" Required="true"
                           RequiredError="Informe a data" Class="mb-3" />

            <CampoNumerico @ref="_quantidade" TNumber="decimal" @bind-Value="Modelo.Quantidade" Label="Quantidade"
                            CasasDecimais="0" Class="mb-3"
                            Validation="@(new Func<decimal, string?>(ValidarQuantidade))" />

            <CampoNumerico @ref="_preco" TNumber="decimal" @bind-Value="Modelo.PrecoUnitario" Label="Preço unitário"
                            Adornment="Adornment.Start" AdornmentText="R$" Class="mb-3"
                            Validation="@(new Func<decimal, string?>(ValidarPreco))" />

            <CampoNumerico @ref="_custos" TNumber="decimal" @bind-Value="Modelo.Custos" Label="Custos (corretagem e emolumentos)"
                            Adornment="Adornment.Start" AdornmentText="R$" Class="mb-3"
                            HelperText="Na compra, entram no preço médio"
                            Validation="@(new Func<decimal, string?>(ValidarCustos))" />

            <MudTextField T="string" @bind-Value="Modelo.Corretora" Label="Corretora (opcional)" Immediate="true" MaxLength="40"
                          Validation="@(new Func<string, string?>(ValidarCorretora))" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public OperacaoAtivoFormModel Modelo { get; set; } = new();
    [Parameter] public List<AtivoFinanceiro> Ativos { get; set; } = new();

    private MudForm _form = null!;
    private MudSelect<int> _ativo = null!;
    private MudDatePicker _data = null!;
    private CampoNumerico<decimal> _quantidade = null!;
    private CampoNumerico<decimal> _preco = null!;
    private CampoNumerico<decimal> _custos = null!;
    private DateTime? _dataOperacao;

    protected override void OnInitialized() => _dataOperacao = Modelo.Data == default ? DateTime.Today : Modelo.Data;

    private static string? ValidarQuantidade(decimal valor)
        => valor > 0 ? null : "A quantidade deve ser maior que zero.";

    private static string? ValidarPreco(decimal valor)
        => valor > 0 ? null : "O preço deve ser maior que zero.";

    private static string? ValidarCustos(decimal valor)
        => valor >= 0 ? null : "Os custos não podem ser negativos.";

    private static string? ValidarCorretora(string valor)
        => valor is { Length: > 40 } ? "A corretora deve ter no máximo 40 caracteres." : null;

    private async Task SalvarAsync()
    {
        Modelo.Data = _dataOperacao ?? default;
        await _form.ValidateAsync();
        if (Modelo.AtivoId <= 0 || _dataOperacao is null || !_form.IsValid)
        {
            await FocarPrimeiroInvalidoAsync();
            return;
        }

        MudDialog.Close(DialogResult.Ok(Modelo));
    }

    private async Task FocarPrimeiroInvalidoAsync()
    {
        if (Modelo.AtivoId <= 0)
        {
            await _ativo.FocusAsync();
            return;
        }

        if (_dataOperacao is null)
        {
            await _data.FocusAsync();
            return;
        }

        if (Modelo.Quantidade <= 0)
        {
            await _quantidade.FocusAsync();
            return;
        }

        if (Modelo.PrecoUnitario <= 0)
            await _preco.FocusAsync();
        else if (Modelo.Custos < 0)
            await _custos.FocusAsync();
    }
}
