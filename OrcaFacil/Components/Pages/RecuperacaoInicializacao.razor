@inject InicializacaoApp Inicializacao

<div class="of-boot">
    <section class="of-boot-card">
        <p class="of-boot-marca">Pro Orçamento</p>
        @if (_falhou)
        {
            @if (_atualizacao)
            {
                <h1>Atualize o Pro Orçamento</h1>
                <p>
                    Os dados neste aparelho são de uma versão mais nova do aplicativo.
                    Atualize o Pro Orçamento para abri-los. Nenhum arquivo foi apagado e nenhum dado novo foi criado.
                </p>
            }
            else
            {
                <h1>Não foi possível abrir seus dados</h1>
                <p>
                    O arquivo orcafacil.db continua no aparelho. Nenhum lançamento foi apagado e nenhum dado fictício foi criado.
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(_passo))
            {
                <p class="of-boot-passo">Etapa: @_passo</p>
            }
            <p class="of-boot-detalhe" role="alert">@(_resumo ?? "Erro sem mensagem.")</p>
            <p class="of-boot-log">O erro completo foi gravado na pasta de logs do aplicativo.</p>
            <button type="button" disabled="@_tentando" @onclick="TentarNovamenteAsync">
                @(_tentando ? "Tentando de novo…" : "Tentar novamente")
            </button>
        }
        else
        {
            <h1 role="status">Preparando o Pro Orçamento…</h1>
            <p>Estamos organizando seus lançamentos. Seus dados permanecem no aparelho.</p>
        }
    </section>
</div>

@code {
    private bool _falhou;
    private bool _atualizacao;
    private bool _tentando;
    private string? _passo;
    private string? _resumo;

    protected override void OnInitialized()
    {
        Atualizar();
    }

    protected override void OnParametersSet() => Atualizar();

    private void Atualizar()
    {
        var (fase, passo, resumo, atualizacao) = Inicializacao.LerEstado();
        _falhou = DecisaoAbertura.MostrarFalha(fase);
        _atualizacao = atualizacao;
        _passo = passo;
        _resumo = resumo;
        if (fase != FaseInicializacao.EmAndamento)
            _tentando = false;
    }

    private async Task TentarNovamenteAsync()
    {
        if (_tentando)
            return;

        _tentando = true;
        try
        {
            await Inicializacao.TentarNovamenteAsync();
        }
        finally
        {
            _tentando = false;
        }
    }
}
