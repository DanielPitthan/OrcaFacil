@page "/"
@using System.Globalization
@implements IDisposable
@inject INoticiaService Noticias
@inject ITransacaoService TransacaoService
@inject IOrcamentoService OrcamentoService
@inject IMetaService MetaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject CascoNavegacao Casco

<div class="of-inicio">
    @if (_painel is null)
    {
        <MudSkeleton Height="180px" Class="of-inicio-esqueleto" />
        <MudSkeleton Height="72px" Class="of-inicio-esqueleto" />
    }
    else
    {
        <MonthSummaryCard Compact="true" Sobra="@_painel.Saldo" TextoSobra="@_painel.TextoSaldo"
                          RotuloSaldo="@_painel.RotuloSaldo" RotuloAcessivel="@_painel.RotuloAcessivelResumo"
                          TextoReceitas="@_painel.TextoReceitas" TextoDespesas="@_painel.TextoDespesas"
                          TextoAPagar="@_painel.TextoAPagar"
                          TextoReceitaComprometida="@_painel.TextoReceitaComprometida"
                          ProgressoReceita="@_painel.ProgressoReceita" ReceitaCritica="@_painel.ReceitaCritica" />

        <BudgetAlertBanner Visivel="@_painel.ExibirAlertaOrcamento"
                           Titulo="@_painel.TextoResumoOrcamentos" Resumo="@_painel.ResumoAlerta" />

        @if (_painel.MetaDestaque is { } meta)
        {
            <GoalProgress Compact="true" Nome="@meta.Nome" TextoPercentual="@meta.TextoPercentual"
                          Progresso="@meta.Progresso" />
        }
    }

    <NewsFeed Escopo="_escopo" EscopoChanged="AlterarEscopo" Itens="_noticias" Carregando="_carregandoNoticias"
              Erro="@_erro" Aviso="@_aviso" Atualizar="AtualizarAsync" AoAbrir="AbrirAsync" />
</div>

<div class="of-inicio-fab">
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="Novo lançamento"
            aria-label="Novo lançamento" OnClick="NovoLancamento" />
</div>

@code {
    private const string MensagemFalha = "Não foi possível carregar as notícias. Verifique a conexão.";

    private bool _carregandoNoticias = true;
    private bool _cascoLigado;
    private EscopoNoticia _escopo = EscopoNoticia.Brasil;
    private PainelInicio? _painel;
    private List<Noticia> _brasil = [];
    private List<Noticia> _mundo = [];
    private string? _erroBrasil;
    private string? _erroMundo;
    private string? _avisoBrasil;
    private string? _avisoMundo;
    private IReadOnlyList<LinhaNoticia> _noticias = [];
    private string? _erro;
    private string? _aviso;

    private RenderFragment Barra => @<text>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Abrir menu" OnClick="AbrirMenu" />
        <span class="of-appbar-titulos">
            <span class="of-appbar-titulo">Início</span>
            <span class="of-appbar-sub">@_painel?.NomeMes</span>
        </span>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        Casco.Definir(Barra);
        _cascoLigado = true;
        await Task.WhenAll(CarregarResumoAsync(), CarregarNoticiasAsync(forcar: false));
    }

    private async Task CarregarResumoAsync()
    {
        var hoje = DateTime.Today;
        var mes = new ResumoMensalDto();
        var alertas = new List<AlertaOrcamentoDto>();
        var metas = new List<Meta>();
        try
        {
            mes = await TransacaoService.ObterResumoMensalAsync(hoje.Month, hoje.Year);
            alertas = await OrcamentoService.ObterAlertasAsync(hoje.Month, hoje.Year);
            metas = await MetaService.ListarAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível carregar o resumo.", Severity.Error);
        }

        _painel = PainelInicio.Montar(new EntradaPainelInicio(
            PeriodoResumo.EsteMes,
            mes,
            new ResumoAcumuladoDto(),
            [],
            [],
            alertas,
            metas,
            hoje), CultureInfo.CurrentCulture);
        Casco.Atualizar();
    }

    private Task AtualizarAsync() => CarregarNoticiasAsync(forcar: true);

    private async Task CarregarNoticiasAsync(bool forcar)
    {
        _carregandoNoticias = true;
        try
        {
            await Task.WhenAll(
                CarregarEscopoAsync(EscopoNoticia.Brasil, forcar),
                CarregarEscopoAsync(EscopoNoticia.Mundo, forcar));
        }
        finally
        {
            _carregandoNoticias = false;
            PublicarNoticias();
        }
    }

    private async Task CarregarEscopoAsync(EscopoNoticia escopo, bool forcar)
    {
        var lista = Lista(escopo);
        try
        {
            var resultado = await Noticias.ListarAsync(escopo, forcar);
            Definir(escopo, resultado.Itens.ToList(), erro: null, resultado.Aviso);
        }
        catch (Exception)
        {
            if (lista.Count == 0)
                Definir(escopo, lista, MensagemFalha, aviso: null);
            else
                Definir(escopo, lista, erro: null, NoticiaService.AvisoListaAnterior);
        }
    }

    private void AlterarEscopo(EscopoNoticia escopo)
    {
        if (escopo == _escopo)
            return;
        _escopo = escopo;
        PublicarNoticias();
    }

    private void PublicarNoticias()
    {
        var lista = Lista(_escopo);
        _erro = _escopo == EscopoNoticia.Brasil ? _erroBrasil : _erroMundo;
        _aviso = _escopo == EscopoNoticia.Brasil ? _avisoBrasil : _avisoMundo;
        _noticias = PainelInicio.FormatarNoticias(lista, DateTimeOffset.Now);
    }

    private List<Noticia> Lista(EscopoNoticia escopo) =>
        escopo == EscopoNoticia.Brasil ? _brasil : _mundo;

    private void Definir(EscopoNoticia escopo, List<Noticia> itens, string? erro, string? aviso)
    {
        if (escopo == EscopoNoticia.Brasil)
        {
            _brasil = itens;
            _erroBrasil = erro;
            _avisoBrasil = aviso;
        }
        else
        {
            _mundo = itens;
            _erroMundo = erro;
            _avisoMundo = aviso;
        }
    }

    private async Task AbrirAsync(string link)
    {
        try
        {
            await Browser.Default.OpenAsync(link, BrowserLaunchMode.SystemPreferred);
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível abrir a notícia.", Severity.Error);
        }
    }

    private void NovoLancamento() => Navigation.NavigateTo("/lancamentos/novo");

    private void AbrirMenu() => Casco.SolicitarMenu();

    public void Dispose()
    {
        if (_cascoLigado)
            Casco.Definir(null);
    }
}
