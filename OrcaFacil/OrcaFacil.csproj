<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>OrcaFacil</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Pro Orçamento</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.pitthan.orcafacil</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#659ECD" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#659ECD" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="MudBlazor" Version="9.9.0" />
        <PackageReference Include="Plugin.LocalNotification" Version="14.1.1" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OrcaFacil.Core\OrcaFacil.Core.csproj" />
    </ItemGroup>

    <!-- WebView 83 do emulador Android não interpreta o blazor.webview.js original do .NET 10.
         O arquivo que entra no APK é o que ConvertStaticWebAssetsToMauiAssets aponta como MauiAsset.
         O patch precisa rodar antes desse alvo. MSBuild puro: não chama powershell/pwsh. -->
    <UsingTask TaskName="OrcaFacilPatchBlazorWebView" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <PackageRoot ParameterType="System.String" Required="true" />
            <ObjDirectory ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var roots = new[]
                {
                    Path.Combine(PackageRoot, "microsoft.aspnetcore.components.webview"),
                    ObjDirectory
                };
                var files = new List<string>();
                foreach (var root in roots)
                {
                    if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
                        continue;
                    files.AddRange(Directory.EnumerateFiles(root, "blazor.webview.js", SearchOption.AllDirectories));
                }

                if (files.Count == 0)
                {
                    Log.LogError("blazor.webview.js não encontrado.");
                    return false;
                }

                var utf8 = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
                foreach (var file in files)
                {
                    var text = File.ReadAllText(file);
                    var adjusted = text
                        .Replace("static{this.nextEventDelegatorId=0}", "static nextEventDelegatorId=0;")
                        .Replace("static nextEventDelegatorId=0constructor", "static nextEventDelegatorId=0;constructor")
                        .Replace("t||=[]", "t=t||[]")
                        .Replace("t[Ue]??={}", "(t[Ue]=t[Ue]??{})");
                    if (adjusted.Contains("static{"))
                    {
                        Log.LogError("O padrão static{ permaneceu em " + file);
                        return false;
                    }

                    if (adjusted == text)
                        continue;

                    var info = new FileInfo(file);
                    if (info.IsReadOnly)
                        info.IsReadOnly = false;
                    File.WriteAllText(file, adjusted, utf8);
                    Log.LogMessage(MessageImportance.High, "Ajustado para WebView antigo: " + file);
                }

                return true;
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="PatchBlazorWebViewForLegacyAndroid" BeforeTargets="ConvertStaticWebAssetsToMauiAssets">
        <OrcaFacilPatchBlazorWebView PackageRoot="$(NuGetPackageRoot)" ObjDirectory="$(MSBuildProjectDirectory)/obj" />
    </Target>

</Project>
